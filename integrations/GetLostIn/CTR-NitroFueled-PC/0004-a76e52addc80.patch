+        return "other";
+    auto suffix = end == path.npos ? std::string_view{} : path.substr(end);
+    if (suffix.empty())
+        return method == 0 ? "session_read" : method == 3 ? "session_delete" : "session_update";
+    if (suffix == "/members")
