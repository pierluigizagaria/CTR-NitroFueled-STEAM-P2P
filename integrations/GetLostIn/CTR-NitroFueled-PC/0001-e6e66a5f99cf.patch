+static PSN_GUEST_ABI int32_t np_online(int32_t user, GuestOnlineId *out) {
+    if (!out)
+        return PSN_INVALID_ARGUMENT;
+    PsnIdentity identity = {0};
+    int32_t rc = signed_identity(user, &identity);
+    if (!rc)
+        online_to_guest(out, identity.online_id);
+    return rc;
