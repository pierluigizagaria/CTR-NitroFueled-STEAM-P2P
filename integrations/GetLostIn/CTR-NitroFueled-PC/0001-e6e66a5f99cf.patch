+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Native adapter for the versioned loopback relay. Steam and PSN semantic
+ * mapping belong to the bridge's provider; guest callbacks belong to psn-host.
+ */
+#include "../include/psn_backend.h"
+#include <algorithm>
+#include <atomic>
+#include <charconv>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <curl/curl.h>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <nlohmann/json.hpp>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+using Json = nlohmann::json;
+constexpr size_t body_limit = 256 * 1024, wire_limit = 1024 * 1024;
+constexpr size_t event_limit = 1024, job_limit = 128;
+struct Invalid : std::runtime_error {
+    using std::runtime_error::runtime_error;
+};
+void require(bool b) {
+    if (!b)
+        throw Invalid("invalid bridge contract");
+}
+std::string text(const Json &j, size_t max, bool empty = true) {
+    require(j.is_string());
+    auto s = j.get<std::string>();
+    require(s.size() <= max && (empty || !s.empty()) && s.find('\0') == std::string::npos);
+    return s;
+}
+std::string input(const char *s, size_t max, bool empty = true) {
+    require(s != nullptr);
+    size_t n = 0;
+    while (n <= max && s[n])
+        ++n;
+    require(n <= max && (empty || n));
+    return std::string(s, n);
+}
+uint64_t decimal(const Json &j, bool zero = false) {
+    auto s = text(j, 20, false);
+    require(s.size() == 1 || s[0] != '0');
+    uint64_t n = 0;
+    auto [p, ec] = std::from_chars(s.data(), s.data() + s.size(), n);
+    require(ec == std::errc{} && p == s.data() + s.size() && (zero || n));
+    return n;
+}
+uint64_t number(const Json &j) {
+    require(j.is_number_unsigned() || (j.is_number_integer() && j.get<int64_t>() >= 0));
+    return j.get<uint64_t>();
+}
+int32_t integer(const Json &j) {
+    require(j.is_number_integer());
+    auto n = j.get<int64_t>();
+    require(n >= INT32_MIN && n <= INT32_MAX);
+    return static_cast<int32_t>(n);
+}
+template <size_t N> void copy(char (&out)[N], const std::string &s) {
+    require(s.size() < N);
+    std::memset(out, 0, N);
+    std::memcpy(out, s.data(), s.size());
+}
+std::string hex(PsnBytes bytes) {
+    require(bytes.size <= body_limit && (!bytes.size || bytes.data));
+    constexpr char digits[] = "0123456789abcdef";
+    std::string out(static_cast<size_t>(bytes.size) * 2, '0');
+    auto p = static_cast<const unsigned char *>(bytes.data);
+    for (size_t i = 0; i < bytes.size; ++i) {
+        out[2 * i] = digits[p[i] >> 4];
+        out[2 * i + 1] = digits[p[i] & 15];
+    }
+    return out;
+}
+std::string unhex(const Json &j) {
+    auto s = text(j, body_limit * 2);
+    require(!(s.size() & 1));
+    auto nibble = [](char c) {
+        require((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'));
+        return c <= '9' ? c - '0' : c - 'a' + 10;
+    };
+    std::string out(s.size() / 2, '\0');
+    for (size_t i = 0; i < out.size(); ++i)
+        out[i] = static_cast<char>((nibble(s[2 * i]) << 4) | nibble(s[2 * i + 1]));
+    return out;
+}
+int32_t status(int32_t s) {
+    switch (s) {
+    case 0:
+        return 0;
+    case -1:
+        return PSN_INVALID_ARGUMENT;
+    case -2:
+        return PSN_SIGNED_OUT;
+    case -4:
+        return PSN_BACKEND_UNSUPPORTED;
+    case -5:
+        return PSN_BACKEND_ABORTED;
+    case -7:
+        return PSN_BACKEND_BUSY;
+    default:
+        return PSN_BACKEND_UNAVAILABLE;
+    }
+}
+struct Job {
+    bool auth = false, active = false, done = false;
+    std::atomic<bool> canceled{false};
+    Json request;
+    PsnAuthResult auth_result{};
+    int32_t result = 0, http = 0;
+    std::string body, content_type;
+    PsnHeader header{};
+};
+struct Subscription {
+    uint32_t kind, label;
+    bool service_present;
+    std::string service, type;
+};
+struct Event {
+    PsnEvent value{};
+    bool service_present = false;
+    std::string service, type, data;
+    std::vector<std::pair<std::string, std::string>> values;
+    std::vector<PsnExtData> ext;
+    void bind() {
+        if (value.kind != 2)
+            return;
+        auto &p = value.data.push;
+        p.service = service_present ? service.c_str() : nullptr;
+        p.data_type = type.c_str();
+        p.data = {data.data(), data.size()};
+        ext.clear();
+        ext.reserve(values.size());
+        for (auto &v : values)
+            ext.push_back({v.first.c_str(), {v.second.data(), v.second.size()}});
+        p.ext_data = ext.data();
+        p.ext_data_count = static_cast<uint32_t>(ext.size());
+    }
+};
+struct Instance {
+    std::string url, token;
+    int32_t local_user_id = 1;
+    std::atomic<bool> stopping{false};
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::thread worker, event_worker;
+    PsnIdentity identity{};
+    uint64_t next_job = 1, cursor = 0;
+    int32_t failure = 0;
+    std::map<uint64_t, std::shared_ptr<Job>> jobs;
+    std::deque<uint64_t> pending;
+    std::map<uint64_t, Subscription> subscriptions;
+    std::deque<std::shared_ptr<Event>> events;
+    std::shared_ptr<Event> borrowed;
+};
+struct Transfer {
+    Instance *instance;
+    Job *job;
+    std::string body;
+    bool overflow = false;
+};
+size_t receive(char *ptr, size_t size, size_t count, void *opaque) {
+    auto &t = *static_cast<Transfer *>(opaque);
+    if (count && size > wire_limit / count) {
+        t.overflow = true;
+        return 0;
+    }
+    size_t n = size * count;
+    if (n > wire_limit - t.body.size()) {
+        t.overflow = true;
+        return 0;
+    }
+    try {
+        t.body.append(ptr, n);
+    } catch (...) {
+        return 0;
+    }
+    return n;
+}
+int progress(void *opaque, curl_off_t, curl_off_t, curl_off_t, curl_off_t) {
+    auto &t = *static_cast<Transfer *>(opaque);
+    return t.instance->stopping || (t.job && t.job->canceled);
+}
+struct Reply {
+    CURLcode transport;
+    long http;
+    Json json;
+};
+Reply http(Instance &i, const std::string &path, const Json *body = nullptr, Job *job = nullptr) {
+    std::unique_ptr<CURL, decltype(&curl_easy_cleanup)> curl(curl_easy_init(), curl_easy_cleanup);
+    require(curl != nullptr);
+    Transfer transfer{&i, job, {}, false};
+    auto url = i.url + path;
+    auto payload = body ? body->dump() : std::string{};
+    require(payload.size() <= wire_limit);
+    auto authorization = "Authorization: Bearer " + i.token;
+    curl_slist *raw = nullptr;
+    raw = curl_slist_append(raw, authorization.c_str());
+    raw = curl_slist_append(raw, "Content-Type: application/json");
+    std::unique_ptr<curl_slist, decltype(&curl_slist_free_all)> headers(raw, curl_slist_free_all);
+    require(raw != nullptr);
+    curl_easy_setopt(curl.get(), CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl.get(), CURLOPT_HTTPHEADER, raw);
+    curl_easy_setopt(curl.get(), CURLOPT_PROXY, "");
+    curl_easy_setopt(curl.get(), CURLOPT_FOLLOWLOCATION, 0L);
+    curl_easy_setopt(curl.get(), CURLOPT_PROTOCOLS_STR, "http");
+    curl_easy_setopt(curl.get(), CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(curl.get(), CURLOPT_CONNECTTIMEOUT_MS, 1000L);
+    curl_easy_setopt(curl.get(), CURLOPT_TIMEOUT_MS, job ? 30000L : 2000L);
+    curl_easy_setopt(curl.get(), CURLOPT_WRITEFUNCTION, receive);
+    curl_easy_setopt(curl.get(), CURLOPT_WRITEDATA, &transfer);
+    curl_easy_setopt(curl.get(), CURLOPT_NOPROGRESS, 0L);
+    curl_easy_setopt(curl.get(), CURLOPT_XFERINFOFUNCTION, progress);
+    curl_easy_setopt(curl.get(), CURLOPT_XFERINFODATA, &transfer);
+    if (body) {
+        curl_easy_setopt(curl.get(), CURLOPT_POST, 1L);
+        curl_easy_setopt(curl.get(), CURLOPT_POSTFIELDS, payload.data());
+        curl_easy_setopt(curl.get(), CURLOPT_POSTFIELDSIZE_LARGE,
+                         static_cast<curl_off_t>(payload.size()));
+    }
+    auto result = curl_easy_perform(curl.get());
+    long code = 0;
+    curl_easy_getinfo(curl.get(), CURLINFO_RESPONSE_CODE, &code);
+    require(!transfer.overflow);
+    Json parsed;
+    if (result == CURLE_OK && code == 200) {
+        parsed = Json::parse(transfer.body);
+        require(parsed.is_object());
+    }
+    return {result, code, std::move(parsed)};
+}
+void fail(Instance &i, int32_t error) {
+    if (!i.failure)
+        i.failure = error;
+    i.events.clear();
+    for (auto &[id, job] : i.jobs) {
+        (void)id;
+        job->canceled = true;
+        if (!job->done) {
+            job->done = true;
+            job->result = error;
+            job->auth_result.result = error;
+        }
+    }
+    i.wake.notify_all();
+}
+void peer(const Json &j, uint64_t &account, char (&name)[17], bool unknown = false) {
+    require(j.is_object());
+    account = decimal(j.at("accountId"), unknown);
+    copy(name, text(j.at("onlineId"), 16, unknown));
+    require(account || !name[0]);
+}
+std::shared_ptr<Event> event(const Json &j, const PsnIdentity &identity, int32_t local_user_id) {
+    require(j.is_object() && integer(j.at("version")) == 1);
+    auto e = std::make_shared<Event>();
+    e->value.user_id = local_user_id;
+    auto kind = text(j.at("kind"), 32, false);
+    if (kind == "identity") {
+        e->value.kind = 1;
+        auto &id = e->value.data.identity;
+        id.account_id = decimal(j.at("accountId"), true);
+        copy(id.online_id, text(j.at("onlineId"), 16));
+        require(j.at("signedIn").is_boolean());
+        id.state = j.at("signedIn").get<bool>() ? 2 : 1;
+        require(id.state == 1 || (id.account_id && id.online_id[0]));
+        return e;
+    }
+    uint64_t from = 0, to = 0;
+    char from_name[17]{}, to_name[17]{};
+    peer(j.at("from"), from, from_name, kind == "push");
+    peer(j.at("to"), to, to_name);
+    require(to == identity.account_id);
+    if (kind == "invitationAccepted") {
+        e->value.kind = 3;
+        auto &v = e->value.data.invitation;
+        copy(v.session_id, text(j.at("sessionId"), 45, false));
+        copy(v.invitation_id, text(j.at("invitationId"), 60, false));
+        v.flag = 1;
+        v.accepting_user_id = local_user_id;
+        v.referring_account_id = from;
+        copy(v.accepting_online_id, to_name);
+        copy(v.referring_online_id, from_name);
+    } else {
+        require(kind == "push");
+        e->value.kind = 2;
+        auto &p = e->value.data.push;
+        p.from_account_id = from;
+        p.to_account_id = to;
+        copy(p.from_online_id, from_name);
+        copy(p.to_online_id, to_name);
+        p.from_platform = p.to_platform = 3;
+        e->service_present = !j.at("service").is_null();
+        if (e->service_present)
+            e->service = text(j.at("service"), 255);
+        auto label = number(j.at("serviceLabel"));
+        require(label <= UINT32_MAX);
+        p.service_label = static_cast<uint32_t>(label);
+        e->type = text(j.at("dataType"), 64, false);
+        e->data = text(j.at("data"), 65536);
+        const auto &ext = j.at("extData");
+        require(ext.is_object() && ext.size() <= PSN_MAX_EXT_DATA);
+        for (auto it = ext.begin(); it != ext.end(); ++it) {
+            require(!it.key().empty() && it.key().size() <= 32 &&
+                    it.key().find('\0') == std::string::npos);
+            e->values.emplace_back(it.key(), text(it.value(), 4096));
+        }
+    }
+    return e;
+}
+void poll_events(Instance &i) {
+    uint64_t cursor;
+    {
+        std::lock_guard lock(i.mutex);
+        if (i.failure)
+            return;
+        cursor = i.cursor;
+    }
+    auto reply = http(i, "/psn/v1/events?after=" + std::to_string(cursor));
+    if (reply.transport != CURLE_OK)
+        throw std::runtime_error("transport retry");
+    require(reply.http == 200);
+    auto &j = reply.json;
+    require(integer(j.at("version")) == 1);
+    auto &list = j.at("events");
+    require(list.is_array() && list.size() <= 64);
+    std::lock_guard lock(i.mutex);
+    std::deque<std::shared_ptr<Event>> batch;
+    for (auto &entry : list) {
+        uint64_t sequence = number(entry.at("sequence"));
+        if (sequence <= cursor)
+            continue; // A retried response never replays a delivered invitation.
+        require(sequence == cursor + 1);
+        auto e = event(entry.at("event"), i.identity, i.local_user_id);
+        if (e->value.kind == 1) {
+            auto id = e->value.data.identity;
+            require(id.state == 2 && id.account_id == i.identity.account_id);
+            i.identity = id;
+        }
+        if (e->value.kind == 2) {
+            for (auto &[cookie, sub] : i.subscriptions) {
+                bool match =
+                    e->type == sub.type && e->service_present == sub.service_present &&
+                    e->service == sub.service &&
+                    (!sub.service_present || e->value.data.push.service_label == sub.label);
+                if (match) {
+                    auto clone = std::make_shared<Event>(*e);
+                    clone->value.data.push.subscription = cookie;
+                    batch.push_back(std::move(clone));
+                }
+            }
+        } else
+            batch.push_back(std::move(e));
+        require(batch.size() + i.events.size() <= event_limit);
+        cursor = sequence;
+    }
+    i.events.insert(i.events.end(), batch.begin(), batch.end());
+    i.cursor = cursor;
+}
+void run(Instance &i) noexcept {
+    while (!i.stopping) {
+        std::shared_ptr<Job> job;
+        {
+            std::unique_lock lock(i.mutex);
+            if (i.failure) {
+                i.wake.wait(lock, [&] { return i.stopping.load(); });
+                break;
+            }
+            while (!i.pending.empty()) {
+                auto id = i.pending.front();
+                i.pending.pop_front();
+                auto found = i.jobs.find(id);
+                if (found != i.jobs.end() && !found->second->done) {
+                    job = found->second;
+                    job->active = true;
+                    break;
+                }
+            }
+        }
+        if (job) {
+            // A private result prevents cancel/poll from racing fields filled by
+            // curl.
+            Job result;
+            try {
+                // Use the real job's atomic cancellation during the transfer.
+                auto reply = http(i, job->auth ? "/psn/v1/token" : "/psn/v1/webapi", &job->request,
+                                  job.get());
+                if (reply.transport != CURLE_OK || reply.http != 200)
+                    result.result = PSN_BACKEND_UNAVAILABLE;
+                else {
+                    auto &j = reply.json;
+                    result.result = status(integer(j.at("status")));
+                    if (job->auth && !result.result) {
+                        result.auth_result.issuer_id = integer(j.at("issuerId"));
+                        copy(result.auth_result.value, text(j.at("token"), 4096, false));
+                    } else if (!job->auth && !result.result) {
+                        result.http = integer(j.at("httpStatus"));
+                        require(result.http >= 100 && result.http <= 599);
+                        result.content_type = text(j.at("contentType"), 1024, false);
+                        result.body = unhex(j.at("bodyHex"));
+                    }
+                }
+            } catch (...) {
+                result.result = PSN_BACKEND_UNAVAILABLE;
+            }
+            std::lock_guard lock(i.mutex);
+            if (!job->done) {
+                job->result = result.result;
+                job->auth_result = result.auth_result;
+                job->auth_result.result = result.result;
+                job->http = result.http;
+                job->body = std::move(result.body);
+                job->content_type = std::move(result.content_type);
+                job->done = true;
+            }
+            job->active = false;
+            i.wake.notify_all();
+        }
+        std::unique_lock lock(i.mutex);
+        i.wake.wait(lock, [&] { return i.stopping || !i.pending.empty() || i.failure; });
+    }
+}
+void run_events(Instance &i) noexcept {
+    unsigned failures = 0;
+    while (!i.stopping) {
+        try {
+            poll_events(i);
+            failures = 0;
+        } catch (const Invalid &) {
+            std::lock_guard lock(i.mutex);
+            fail(i, PSN_BACKEND_UNAVAILABLE);
+        } catch (const Json::exception &) {
+            std::lock_guard lock(i.mutex);
+            fail(i, PSN_BACKEND_UNAVAILABLE);
+        } catch (...) {
+            if (++failures >= 5) {
+                std::lock_guard lock(i.mutex);
+                fail(i, PSN_BACKEND_UNAVAILABLE);
+            }
+        }
+        std::unique_lock lock(i.mutex);
+        if (i.failure)
+            i.wake.wait(lock, [&] { return i.stopping.load(); });
+        else
+            i.wake.wait_for(lock, std::chrono::milliseconds(100),
+                            [&] { return i.stopping.load(); });
+    }
+}
+template <class F> int32_t guarded(F f) noexcept {
+    try {
+        return f();
+    } catch (const std::bad_alloc &) {
+        return PSN_BACKEND_NO_MEMORY;
+    } catch (...) {
+        return PSN_INVALID_ARGUMENT;
+    }
+}
+int32_t open(const char *configuration, void **out) {
+    if (!out)
+        return PSN_INVALID_ARGUMENT;
+    *out = nullptr;
+    return guarded([&]() -> int32_t {
+        auto j = Json::parse(input(configuration, 4096, false));
+        require(j.is_object() && (j.size() == 2 || (j.size() == 3 && j.contains("local_user_id"))));
+        auto i = std::make_unique<Instance>();
+        if (j.contains("local_user_id")) {
+            i->local_user_id = integer(j.at("local_user_id"));
+            require(i->local_user_id >= 0);
+        }
+        i->url = text(j.at("url"), 64, false);
+        i->token = text(j.at("token"), 64, false);
+        require(i->token.size() == 64 &&
+                i->token.find_first_not_of("0123456789abcdef") == std::string::npos);
+        // Numeric 127/8 only: no DNS, IPv6 ambiguity, URL credentials, path or
+        // proxy.
+        require(i->url.starts_with("http://127."));
+        auto host = i->url.substr(7);
+        auto colon = host.find(':');
+        require(colon != std::string::npos && host.find(':', colon + 1) == std::string::npos);
+        auto ip = host.substr(0, colon);
+        size_t pos = 0;
+        for (unsigned part = 0; part < 4; ++part) {
+            size_t end = ip.find('.', pos);
+            require((part == 3) == (end == std::string::npos));
+            auto s = ip.substr(pos, end == std::string::npos ? end : end - pos);
+            uint32_t value = 0;
+            auto [p, ec] = std::from_chars(s.data(), s.data() + s.size(), value);
+            require(!s.empty() && s.size() <= 3 && (s.size() == 1 || s[0] != '0') &&
+                    ec == std::errc{} && p == s.data() + s.size() && value <= 255);
+            pos = end + 1;
+        }
+        auto port = host.substr(colon + 1);
+        uint32_t n = 0;
+        auto [p, ec] = std::from_chars(port.data(), port.data() + port.size(), n);
+        require(ec == std::errc{} && p == port.data() + port.size() && n && n <= 65535);
+        static const int curl_initialized = curl_global_init(CURL_GLOBAL_DEFAULT);
+        require(curl_initialized == CURLE_OK);
+        auto reply = http(*i, "/psn/v1/info");
+        if (reply.transport != CURLE_OK || reply.http != 200) {
+            std::fprintf(stderr, "PSN bridge: handshake failed (transport %d, HTTP %ld).\n",
+                         static_cast<int>(reply.transport), reply.http);
+            return PSN_BACKEND_UNAVAILABLE;
+        }
+        auto &info = reply.json;
+        require(integer(info.at("version")) == 1 && info.at("signedIn") == true);
+        i->identity.account_id = decimal(info.at("accountId"));
+        copy(i->identity.online_id, text(info.at("onlineId"), 16, false));
+        i->identity.state = 2;
+        const auto &caps = info.at("capabilities");
+        require(caps.is_array());
+        for (const char *cap : {"identity", "id-token", "webapi", "push", "invitation-accepted"})
+            require(std::find(caps.begin(), caps.end(), cap) != caps.end());
+        i->worker = std::thread([ptr = i.get()] { run(*ptr); });
+        try {
+            i->event_worker = std::thread([ptr = i.get()] { run_events(*ptr); });
+        } catch (...) {
+            i->stopping = true;
+            i->wake.notify_all();
+            i->worker.join();
+            throw;
+        }
+        *out = i.release();
+        return 0;
+    });
+}
+void close(void *opaque) {
+    auto i = static_cast<Instance *>(opaque);
+    if (!i)
+        return;
+    i->stopping = true;
+    i->wake.notify_all();
+    if (i->worker.joinable())
+        i->worker.join();
+    if (i->event_worker.joinable())
+        i->event_worker.join();
+    delete i;
+}
+int32_t identity(void *opaque, int32_t user, PsnIdentity *out) {
+    if (!opaque || !out || user != static_cast<Instance *>(opaque)->local_user_id)
+        return PSN_INVALID_ARGUMENT;
+    auto &i = *static_cast<Instance *>(opaque);
+    std::lock_guard lock(i.mutex);
+    if (i.failure)
+        return i.failure;
+    *out = i.identity;
+    return 0;
+}
+int32_t policy(void *opaque, int32_t user, uint64_t, PsnPolicy *out) {
+    PsnIdentity id;
+    auto rc = identity(opaque, user, &id);
+    if (rc || !out)
+        return rc ? rc : PSN_INVALID_ARGUMENT;
+    *out = {};
+    out->plus_authorized = 1;
+    out->age = 99;
+    return 0;
+}
+int32_t title(void *, const char *name, PsnBytes secret) {
+    return guarded([&]() -> int32_t {
+        auto s = input(name, 12, false);
+        require(secret.data && secret.size == 128);
+        return 0;
+    });
+}
+int32_t restriction(void *, const PsnContentRestriction *r) {
+    if (!r || r->default_age < 0 || r->count > 256 || (r->count && !r->countries))
+        return PSN_INVALID_ARGUMENT;
+    for (uint32_t n = 0; n < r->count; ++n)
+        if (r->countries[n].age < 0 || r->countries[n].country[2])
+            return PSN_INVALID_ARGUMENT;
+    return 0; // Local adult profile; no claim that Steam enforced a PSN parental
+              // policy.
+}
+int32_t submit(Instance &i, std::shared_ptr<Job> job, uint64_t *out) {
+    std::lock_guard lock(i.mutex);
+    if (i.failure)
+        return i.failure;
+    if (i.jobs.size() >= job_limit || i.next_job == UINT64_MAX)
+        return PSN_BACKEND_BUSY;
+    auto id = i.next_job++;
+    i.jobs.emplace(id, std::move(job));
+    try {
+        i.pending.push_back(id);
+    } catch (...) {
+        i.jobs.erase(id);
+        throw;
+    }
+    *out = id;
+    i.wake.notify_all();
+    return 0;
+}
+int32_t auth_start(void *opaque, const PsnAuthRequest *r, uint64_t *out) {
+    if (!opaque || !r || !out || r->user_id != static_cast<Instance *>(opaque)->local_user_id)
+        return PSN_INVALID_ARGUMENT;
+    if (r->kind != 1)
+        return PSN_BACKEND_UNSUPPORTED;
+    return guarded([&]() -> int32_t {
+        auto job = std::make_shared<Job>();
+        job->auth = true;
+        job->request = {{"kind", 1},
+                        {"client_id", input(r->client_id, 4096, false)},
+                        {"scope", input(r->scope ? r->scope : "", 4096)}};
+        // The local capability does not use a Sony application secret. Validate the
+        // original call's bounded input without forwarding or logging it.
+        if (r->client_secret)
+            input(r->client_secret, 4096);
+        return submit(*static_cast<Instance *>(opaque), job, out);
+    });
+}
+int32_t auth_poll(void *opaque, uint64_t id, PsnAuthResult *out) {
+    if (!opaque || !out)
+        return PSN_INVALID_ARGUMENT;
+    auto &i = *static_cast<Instance *>(opaque);
+    std::lock_guard lock(i.mutex);
+    auto found = i.jobs.find(id);
+    if (found == i.jobs.end() || !found->second->auth)
+        return PSN_INVALID_ARGUMENT;
+    if (!found->second->done)
+        return 1;
+    *out = found->second->auth_result;
+    return 0;
+}
+int32_t web_start(void *opaque, const PsnWebRequest *r, uint64_t *out) {
+    if (!opaque || !r || !out || r->user_id != static_cast<Instance *>(opaque)->local_user_id ||
+        r->method > 4 || r->header_count > PSN_MAX_HEADERS || (r->header_count && !r->headers))
+        return PSN_INVALID_ARGUMENT;
+    if (r->body.size > body_limit)
+        return PSN_BACKEND_UNSUPPORTED;
+    return guarded([&]() -> int32_t {
+        constexpr const char *methods[] = {"GET", "POST", "PUT", "DELETE", "PATCH"};
+        auto path = input(r->path, 8192, false);
+        require(path[0] == '/' && !path.starts_with("//") &&
+                path.find_first_of("\r\n") == std::string::npos);
+        Json headers = Json::object();
+        std::set<std::string> names;
+        for (uint32_t n = 0; n < r->header_count; ++n) {
+            auto name = input(r->headers[n].name, 256, false),
+                 value = input(r->headers[n].value, 8192);
+            require(name.find_first_of("\r\n:") == std::string::npos &&
+                    value.find_first_of("\r\n") == std::string::npos);
+            auto lower = name;
+            for (auto &c : lower)
+                if (c >= 'A' && c <= 'Z')
+                    c += 'a' - 'A';
+            if (!names.insert(lower).second)
+                return PSN_BACKEND_UNSUPPORTED;
+            headers[name] = value;
+        }
+        auto job = std::make_shared<Job>();
+        job->request = {{"method", methods[r->method]},
+                        {"api_group", input(r->api_group, 256, false)},
+                        {"path", path},
+                        {"content_type", input(r->content_type ? r->content_type : "", 1024)},
+                        {"headers", headers}};
+        if (job->request.dump().size() > 65536)
+            return PSN_BACKEND_UNSUPPORTED;
+        job->request["bodyHex"] = hex(r->body);
+        return submit(*static_cast<Instance *>(opaque), job, out);
+    });
+}
+int32_t web_poll(void *opaque, uint64_t id, PsnWebResponse *out) {
+    if (!opaque || !out)
+        return PSN_INVALID_ARGUMENT;
+    auto &i = *static_cast<Instance *>(opaque);
+    std::lock_guard lock(i.mutex);
+    auto found = i.jobs.find(id);
+    if (found == i.jobs.end() || found->second->auth)
+        return PSN_INVALID_ARGUMENT;
+    auto &job = *found->second;
+    if (!job.done)
+        return 1;
+    *out = {};
+    out->result = job.result;
+    out->http_status = job.http;
+    job.header = {"Content-Type", job.content_type.c_str()};
+    if (!job.result) {
+        out->header_count = 1;
+        out->headers = &job.header;
+        out->body = {job.body.data(), job.body.size()};
+    }
+    return 0;
+}
+void cancel(void *opaque, uint64_t id) {
+    if (!opaque)
+        return;
+    auto &i = *static_cast<Instance *>(opaque);
+    std::lock_guard lock(i.mutex);
+    auto found = i.jobs.find(id);
+    if (found == i.jobs.end() || found->second->done)
+        return;
+    auto &job = *found->second;
+    job.canceled = true;
+    job.done = true;
+    job.result = job.auth_result.result = PSN_BACKEND_ABORTED;
+    i.wake.notify_all();
+}
+void release(void *opaque, uint64_t id) {
+    if (!opaque)
+        return;
+    cancel(opaque, id);
+    auto &i = *static_cast<Instance *>(opaque);
+    std::unique_lock lock(i.mutex);
+    auto found = i.jobs.find(id);
+    if (found == i.jobs.end())
+        return;
+    auto job = found->second;
+    i.wake.wait(lock, [&] { return !job->active; });
+    i.jobs.erase(id);
+    std::erase(i.pending, id);
+}
+int32_t subscribe(void *opaque, uint64_t cookie, const PsnPushFilter *f) {
+    if (!opaque || !f || !cookie || f->user_id != static_cast<Instance *>(opaque)->local_user_id ||
+        f->kind < 1 || f->kind > 3 || f->ext_key_count > PSN_MAX_EXT_DATA ||
+        (f->ext_key_count && !f->ext_keys))
+        return PSN_INVALID_ARGUMENT;
+    return guarded([&]() -> int32_t {
+        Subscription s{f->kind, f->service_label, f->service != nullptr,
+                       input(f->service ? f->service : "", 255), input(f->data_type, 64, false)};
+        for (uint32_t n = 0; n < f->ext_key_count; ++n)
+            input(f->ext_keys[n], 32, false);
+        auto &i = *static_cast<Instance *>(opaque);
+        std::lock_guard lock(i.mutex);
+        if (i.failure)
+            return i.failure;
+        if (i.subscriptions.size() >= 512 || i.subscriptions.contains(cookie))
+            return PSN_BACKEND_BUSY;
+        i.subscriptions.emplace(cookie, std::move(s));
+        return 0;
+    });
+}
+void unsubscribe(void *opaque, uint64_t cookie) {
+    if (!opaque)
+        return;
+    auto &i = *static_cast<Instance *>(opaque);
+    std::lock_guard lock(i.mutex);
+    i.subscriptions.erase(cookie);
+    std::erase_if(i.events, [&](const auto &e) {
+        return e->value.kind == 2 && e->value.data.push.subscription == cookie;
+    });
+}
+int32_t event_next(void *opaque, PsnEvent *out) {
+    if (!opaque || !out)
+        return PSN_INVALID_ARGUMENT;
+    return guarded([&]() -> int32_t {
+        auto &i = *static_cast<Instance *>(opaque);
+        std::lock_guard lock(i.mutex);
+        i.borrowed.reset();
+        if (i.failure)
+            return i.failure;
+        if (i.events.empty())
+            return 0;
+        i.borrowed = i.events.front();
+        i.events.pop_front();
+        i.borrowed->bind();
+        *out = i.borrowed->value;
+        return 1;
+    });
+}
+int32_t invitation_start(void *, const PsnInvitationRequest *, uint64_t *) {
+    return PSN_BACKEND_UNSUPPORTED;
+}
+int32_t invitation_poll(void *, uint64_t, PsnInvitationResult *) { return PSN_BACKEND_UNSUPPORTED; }
+void invitation_noop(void *, uint64_t) {}
+const PsnBackendV1 backend{sizeof(PsnBackendV1),
+                           PSN_BACKEND_ABI_V1,
+                           PSN_PROFILE_SOCIAL_V1,
+                           open,
+                           close,
+                           identity,
+                           policy,
+                           title,
+                           restriction,
+                           auth_start,
+                           auth_poll,
+                           cancel,
+                           release,
+                           web_start,
+                           web_poll,
+                           cancel,
+                           release,
+                           subscribe,
+                           unsubscribe,
+                           event_next,
+                           invitation_start,
+                           invitation_poll,
+                           invitation_noop,
+                           invitation_noop};
+} // namespace
+#ifdef _WIN32
+#define PSN_EXPORT __declspec(dllexport)
+#else
+#define PSN_EXPORT __attribute__((visibility("default")))
+#endif
+extern "C" PSN_EXPORT const PsnBackendV1 *psn_backend_query(uint32_t version) {
+    return version == PSN_BACKEND_ABI_V1 ? &backend : nullptr;
+}
diff --git a/platform/psn/backends/copy_runtime.cmake b/platform/psn/backends/copy_runtime.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..9defee09c91ae9e4e806191c5aec1d2cd1322236
--- /dev/null
+++ b/platform/psn/backends/copy_runtime.cmake
@@ -0,0 +1,19 @@
+# Build-tree deployment only. No installation or changes outside the target directory.
+cmake_minimum_required(VERSION 3.24)
+if(POLICY CMP0207)
+    cmake_policy(SET CMP0207 NEW)
+endif()
+set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
+set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
+set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${OBJDUMP}")
+file(GET_RUNTIME_DEPENDENCIES LIBRARIES "${MODULE}" DIRECTORIES "${SEARCH}"
+    RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR missing
+    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
+    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*")
+if(missing)
+    message(FATAL_ERROR "Backend runtime dependencies were not found: ${missing}")
+endif()
+get_filename_component(destination "${MODULE}" DIRECTORY)
+foreach(dependency IN LISTS resolved)
+    file(COPY "${dependency}" DESTINATION "${destination}")
+endforeach()
diff --git a/platform/psn/include/psn_backend.h b/platform/psn/include/psn_backend.h
new file mode 100644
index 0000000000000000000000000000000000000000..acad3bbce5af842e3f4b49bba2912e16e62391ff
--- /dev/null
+++ b/platform/psn/include/psn_backend.h
@@ -0,0 +1,208 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PSN_BACKEND_H
+#define PSN_BACKEND_H
+
+/* Host binding for PS4 NP contracts, not a Sony SDK header or a wire protocol.
+ * Native C calling convention, fixed-width fields, one selected backend per process.
+ * No guest addresses, callbacks, host sockets or host-private structures cross this ABI.
+ * Input strings/spans are borrowed for the call only: asynchronous implementations MUST
+ * copy them before returning. Output spans are backend-owned until the next backend call;
+ * the host copies them under its backend lock. No backend function calls into the host.
+ * All calls are serialized by the host. Starts, polls and event_next must not wait for
+ * network I/O; release/close quiesce workers without requiring another host call.
+ * Successful start calls return a nonzero opaque handle. close() frees all resources.
+ */
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PSN_BACKEND_ABI_V1 1u
+#define PSN_CAP_IDENTITY (UINT64_C(1) << 0)
+#define PSN_CAP_AUTH (UINT64_C(1) << 1)
+#define PSN_CAP_WEBAPI (UINT64_C(1) << 2)
+#define PSN_CAP_PUSH (UINT64_C(1) << 3)
+#define PSN_CAP_INVITATION (UINT64_C(1) << 4)
+#define PSN_PROFILE_SOCIAL_V1                                                                      \
+    (PSN_CAP_IDENTITY | PSN_CAP_AUTH | PSN_CAP_WEBAPI | PSN_CAP_PUSH | PSN_CAP_INVITATION)
+#define PSN_MAX_BODY (16u * 1024u * 1024u)
+#define PSN_MAX_HEADERS 64u
+#define PSN_MAX_EXT_DATA 32u
+#define PSN_INVALID_ARGUMENT ((int32_t)0x80550003)
+#define PSN_SIGNED_OUT ((int32_t)0x80550006)
+/* Host binding errors, not claims about unverified Sony error constants. */
+#define PSN_BACKEND_UNAVAILABLE ((int32_t)0x80020026)
+#define PSN_BACKEND_UNSUPPORTED ((int32_t)0x8002004e)
+#define PSN_BACKEND_BUSY ((int32_t)0x80020010)
+#define PSN_BACKEND_ABORTED ((int32_t)0x80020055)
+#define PSN_BACKEND_NO_MEMORY ((int32_t)0x8002000c)
+
+typedef struct PsnBytes {
+    const void *data;
+    uint64_t size;
+} PsnBytes;
+typedef struct PsnHeader {
+    const char *name;
+    const char *value;
+} PsnHeader;
+typedef struct PsnIdentity {
+    uint64_t account_id;
+    char online_id[17];
+    uint8_t reserved[3];
+    int32_t state; /* 1 signed out, 2 signed in */
+} PsnIdentity;
+typedef struct PsnPolicy {
+    int32_t availability; /* operation result, zero when available */
+    uint8_t plus_authorized, age, content_restricted, chat_restricted, ugc_restricted;
+    uint8_t reserved[3];
+} PsnPolicy;
+typedef struct PsnAuthTimeout {
+    int32_t resolve_retry;
+    uint32_t resolve_timeout, connect_timeout, send_timeout, receive_timeout;
+} PsnAuthTimeout;
+typedef struct PsnAgeRestriction {
+    char country[4];
+    int32_t age;
+} PsnAgeRestriction;
+typedef struct PsnContentRestriction {
+    int32_t default_age;
+    uint32_t count;
+    const PsnAgeRestriction *countries;
+} PsnContentRestriction;
+typedef struct PsnAuthRequest {
+    int32_t user_id;
+    uint32_t kind;        /* 1 ID token, 2 authorization code */
+    uint32_t api_variant; /* 0 legacy, 1 A, 3 V3 */
+    uint32_t has_timeout;
+    PsnAuthTimeout timeout;
+    const char *client_id;
+    const char *client_secret;
+    const char *scope;
+} PsnAuthRequest;
+typedef struct PsnAuthResult {
+    int32_t result, issuer_id;
+    char value[4097]; /* token <=4096, authorization code <=128, terminated */
+} PsnAuthResult;
+typedef struct PsnWebRequest {
+    int32_t user_id;
+    uint32_t method; /* PS4 order: GET=0 POST=1 PUT=2 DELETE=3 PATCH=4 */
+    const char *api_group;
+    const char *path; /* includes the unmodified query string */
+    const char *content_type;
+    const PsnHeader *headers;
+    uint32_t header_count;
+    uint32_t reserved;
+    PsnBytes body; /* binary/multipart bytes, never assumed to be JSON */
+} PsnWebRequest;
+typedef struct PsnWebResponse {
+    int32_t result, http_status;
+    const PsnHeader *headers;
+    uint32_t header_count;
+    uint32_t reserved;
+    PsnBytes body, error_object;
+} PsnWebResponse;
+typedef struct PsnPushFilter {
+    int32_t user_id;
+    uint32_t kind;       /* 1 basic, 2 service, 3 extended service */
+    const char *service; /* NULL: unqualified/basic; "": named empty service, distinct */
+    const char *data_type;
+    const char *const *ext_keys;
+    uint32_t ext_key_count;
+    uint32_t service_label;
+} PsnPushFilter;
+typedef struct PsnExtData {
+    const char *key;
+    PsnBytes value;
+} PsnExtData;
+typedef struct PsnPushEvent {
+    uint64_t subscription; /* cookie supplied to subscribe(), never a guest pointer */
+    uint64_t from_account_id, to_account_id;
+    char from_online_id[17], to_online_id[17];
+    uint8_t padding[2];
+    int32_t from_platform, to_platform; /* PS3=1, Vita=2, PS4=3 */
+    const char *service;
+    const char *data_type;
+    PsnBytes data;
+    const PsnExtData *ext_data;
+    uint32_t ext_data_count;
+    uint32_t service_label;
+} PsnPushEvent;
+typedef struct PsnSessionInvitation {
+    char session_id[46], invitation_id[61];
+    uint8_t reserved;
+    uint32_t flag;
+    int32_t accepting_user_id;
+    char accepting_online_id[17], referring_online_id[17];
+    uint8_t padding[2];
+    uint64_t referring_account_id;
+} PsnSessionInvitation;
+typedef struct PsnEvent {
+    uint32_t kind; /* 1 NP state, 2 WebAPI push, 3 accepted invitation,
+                     4 game presence, 5 Plus event, 6 NP reachability */
+    int32_t user_id;
+    union {
+        PsnIdentity identity;
+        PsnPushEvent push;
+        PsnSessionInvitation invitation;
+        char online_id[17];
+        int32_t plus_event;
+        int32_t reachability;
+    } data;
+} PsnEvent;
+typedef struct PsnInvitationUser {
+    uint64_t account_id;
+    char online_id[17];
+    uint8_t reserved[7];
+} PsnInvitationUser;
+typedef struct PsnInvitationRequest {
+    int32_t user_id;
+    uint32_t mode; /* 1 send, 2 receive */
+    const char *session_id;
+    const char *message;
+    const PsnInvitationUser *users;
+    uint32_t user_count; /* <=16 */
+    uint32_t max_selectable_users;
+} PsnInvitationRequest;
+typedef struct PsnInvitationResult {
+    int32_t error_code, result; /* PS4 common result: OK=0, canceled=1 */
+    uint32_t user_count;
+    uint32_t reserved;
+    PsnInvitationUser users[16]; /* only recipients whose send actually succeeded */
+} PsnInvitationResult;
+
+typedef struct PsnBackendV1 {
+    uint32_t size, abi_version;
+    uint64_t capabilities;
+    /* open: configuration is opaque to the host; failure never selects the legacy backend. */
+    int32_t (*open)(const char *configuration, void **instance);
+    void (*close)(void *instance);
+    int32_t (*identity)(void *, int32_t user_id, PsnIdentity *);
+    int32_t (*policy)(void *, int32_t user_id, uint64_t plus_features, PsnPolicy *);
+    int32_t (*set_title)(void *, const char *title_id, PsnBytes secret);
+    int32_t (*set_content_restriction)(void *, const PsnContentRestriction *);
+    int32_t (*auth_start)(void *, const PsnAuthRequest *, uint64_t *request);
+    int32_t (*auth_poll)(void *, uint64_t request, PsnAuthResult *); /* 1 pending, 0 complete */
+    void (*auth_cancel)(void *, uint64_t request);
+    void (*auth_release)(void *, uint64_t request); /* quiesces request before returning */
+    int32_t (*web_start)(void *, const PsnWebRequest *, uint64_t *request);
+    int32_t (*web_poll)(void *, uint64_t request, PsnWebResponse *); /* 1 pending, 0 complete */
+    void (*web_cancel)(void *, uint64_t request);
+    void (*web_release)(void *, uint64_t request);
+    int32_t (*subscribe)(void *, uint64_t cookie, const PsnPushFilter *);
+    void (*unsubscribe)(void *, uint64_t cookie); /* no subsequent events for cookie */
+    int32_t (*event_next)(void *, PsnEvent *);    /* 1 event, 0 empty, negative error */
+    int32_t (*invitation_start)(void *, const PsnInvitationRequest *, uint64_t *dialog);
+    int32_t (*invitation_poll)(void *, uint64_t dialog, PsnInvitationResult *); /* 1 pending */
+    void (*invitation_cancel)(void *, uint64_t dialog);
+    void (*invitation_release)(void *, uint64_t dialog);
+} PsnBackendV1;
+
+/* Export this symbol using the native C ABI. Return NULL for an unknown ABI version.
+ * The returned immutable table lives until module unload. No initialization in entry(). */
+typedef const PsnBackendV1 *(*PsnBackendEntry)(uint32_t abi_version);
+#define PSN_BACKEND_ENTRY "psn_backend_query"
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/platform/psn/psn_host.c b/platform/psn/psn_host.c
new file mode 100644
index 0000000000000000000000000000000000000000..8d91b96a2f0ccaad859d4bf6c59bfa37fd69c2b2
--- /dev/null
+++ b/platform/psn/psn_host.c
@@ -0,0 +1,393 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Optional platform backend. The unchanged services table is the default implementation. */
+#define _POSIX_C_SOURCE 200809L
+#include "psn_host.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+static pthread_mutex_t backend_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t pump_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t system_mutex = PTHREAD_MUTEX_INITIALIZER;
+static const PsnBackendV1 *backend;
+static void *instance;
+#ifdef _WIN32
+static HMODULE module;
+#else
+static void *module;
+#endif
+static int selection = -1, initialized;
+static int32_t failure;
+#define INVITE_CAPACITY 32
+static PsnSessionInvitation invitations[INVITE_CAPACITY];
+static unsigned invitation_head, invitation_count;
+static int32_t local_users[PSN_MAX_LOCAL_USERS];
+static uint32_t local_user_count;
+
+int32_t psn_host_set_local_users(const int32_t *users, uint32_t count) {
+    if (!users || !count || count > PSN_MAX_LOCAL_USERS)
+        return PSN_INVALID_ARGUMENT;
+    int32_t copied[PSN_MAX_LOCAL_USERS];
+    memcpy(copied, users, count * sizeof(*users));
+    for (uint32_t i = 0; i < count; ++i) {
+        if (copied[i] < 0)
+            return PSN_INVALID_ARGUMENT;
+        for (uint32_t j = 0; j < i; ++j)
+            if (copied[i] == copied[j])
+                return PSN_INVALID_ARGUMENT;
+    }
+    pthread_mutex_lock(&backend_mutex);
+    int32_t result = 0;
+    if (initialized && (count != local_user_count ||
+                        memcmp(local_users, copied, count * sizeof(*users))))
+        result = PSN_BACKEND_BUSY;
+    if (!result) {
+        memcpy(local_users, copied, count * sizeof(*users));
+        local_user_count = count;
+    }
+    pthread_mutex_unlock(&backend_mutex);
+    return result;
+}
+uint32_t psn_host_local_users(int32_t users[PSN_MAX_LOCAL_USERS]) {
+    if (!users)
+        return 0;
+    pthread_mutex_lock(&backend_mutex);
+    uint32_t count = local_user_count;
+    memcpy(users, local_users, count * sizeof(*users));
+    pthread_mutex_unlock(&backend_mutex);
+    return count;
+}
+int psn_host_has_local_user(int32_t user) {
+    int32_t users[PSN_MAX_LOCAL_USERS];
+    uint32_t count = psn_host_local_users(users);
+    for (uint32_t i = 0; i < count; ++i)
+        if (users[i] == user)
+            return 1;
+    return 0;
+}
+
+int psn_host_selected(void) {
+    /* Selection is immutable from the first runtime entry, before NP initialization. */
+    pthread_mutex_lock(&backend_mutex);
+    if (selection < 0) {
+        const char *path = getenv("BB_PSN_BACKEND");
+        selection = path && *path;
+    }
+    const int selected = selection;
+    pthread_mutex_unlock(&backend_mutex);
+    return selected;
+}
+
+static int valid_table(const PsnBackendV1 *b) {
+    return b && b->size >= sizeof(*b) && b->abi_version == PSN_BACKEND_ABI_V1 &&
+           (b->capabilities & PSN_PROFILE_SOCIAL_V1) == PSN_PROFILE_SOCIAL_V1 && b->open &&
+           b->close && b->identity && b->policy && b->set_title && b->set_content_restriction &&
+           b->auth_start && b->auth_poll && b->auth_cancel && b->auth_release && b->web_start &&
+           b->web_poll && b->web_cancel && b->web_release && b->subscribe && b->unsubscribe &&
+           b->event_next && b->invitation_start && b->invitation_poll && b->invitation_cancel &&
+           b->invitation_release;
+}
+static void unload(void) {
+    if (!module)
+        return;
+#ifdef _WIN32
+    FreeLibrary(module);
+#else
+    dlclose(module);
+#endif
+    module = NULL;
+}
+int psn_host_start(void) {
+    if (!psn_host_selected())
+        return 0;
+    pthread_mutex_lock(&backend_mutex);
+    if (initialized) {
+        int32_t result = failure;
+        pthread_mutex_unlock(&backend_mutex);
+        return result;
+    }
+    initialized = 1;
+    if (!local_user_count) {
+        failure = PSN_INVALID_ARGUMENT;
+        fputs("PSN backend: the host has not configured its local user IDs.\n", stderr);
+        pthread_mutex_unlock(&backend_mutex);
+        return failure;
+    }
+    const char *path = getenv("BB_PSN_BACKEND");
+    PsnBackendEntry query = NULL;
+#ifdef _WIN32
+    /* Require an explicit absolute path; dependencies are searched beside the module and
+     * in system directories, never the working directory or a broad process PATH. */
+    if (path && strlen(path) > 3 &&
+        ((path[1] == ':' && (path[2] == '/' || path[2] == '\\')) ||
+         (path[0] == '\\' && path[1] == '\\'))) {
+        wchar_t wide[32768];
+        if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, wide, 32768))
+            module = LoadLibraryExW(
+                wide, NULL, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    }
+    if (module) {
+        FARPROC symbol = GetProcAddress(module, PSN_BACKEND_ENTRY);
+        memcpy(&query, &symbol, sizeof(query));
+    }
+#else
+    if (path && path[0] == '/')
+        module = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (module) {
+        void *symbol = dlsym(module, PSN_BACKEND_ENTRY);
+        memcpy(&query, &symbol, sizeof(query));
+    }
+#endif
+    const PsnBackendV1 *candidate = query ? query(PSN_BACKEND_ABI_V1) : NULL;
+    if (!valid_table(candidate)) {
+        fputs("PSN backend: cannot load the selected module, ABI or required social profile is "
+              "unavailable.\n",
+              stderr);
+        failure = PSN_BACKEND_UNAVAILABLE;
+        unload();
+    } else {
+        const char *config = getenv("BB_PSN_BACKEND_CONFIG");
+        failure = candidate->open(config ? config : "", &instance);
+        if (failure || !instance) {
+            if (instance)
+                candidate->close(instance);
+            instance = NULL;
+            failure = failure < 0 ? failure : PSN_BACKEND_UNAVAILABLE;
+            fputs("PSN backend: selected module failed to initialize.\n", stderr);
+            unload();
+        } else {
+            backend = candidate;
+            atexit(psn_host_stop);
+            puts("Runtime: external PSN backend selected (social profile v1)");
+        }
+    }
+    int32_t result = failure;
+    pthread_mutex_unlock(&backend_mutex);
+    return result;
+}
+const PsnBackendV1 *psn_host_lock(void **out) {
+    pthread_mutex_lock(&backend_mutex);
+    *out = instance;
+    return backend;
+}
+void psn_host_unlock(void) { pthread_mutex_unlock(&backend_mutex); }
+
+void psn_host_stop(void) {
+    /* Called after guest threads stop (process teardown), never from a callback. */
+    pthread_mutex_lock(&pump_mutex);
+    psn_host_webapi_reset();
+    psn_host_identity_reset();
+    pthread_mutex_lock(&backend_mutex);
+    if (backend)
+        backend->close(instance);
+    backend = NULL;
+    instance = NULL;
+    unload();
+    pthread_mutex_unlock(&backend_mutex);
+    pthread_mutex_lock(&system_mutex);
+    invitation_count = invitation_head = 0;
+    pthread_mutex_unlock(&system_mutex);
+    pthread_mutex_unlock(&pump_mutex);
+}
+
+typedef struct CopiedPush {
+    PsnPushEvent event;
+    PsnExtData ext[PSN_MAX_EXT_DATA];
+    char service[256], type[65], keys[PSN_MAX_EXT_DATA][33];
+    void *payload;
+} CopiedPush;
+static int copy_text(char *out, size_t size, const char *value) {
+    if (!value)
+        return 0;
+    size_t n = strnlen(value, size);
+    if (n == size)
+        return 0;
+    memcpy(out, value, n + 1);
+    return 1;
+}
+static int32_t copy_push(CopiedPush *out, const PsnPushEvent *in) {
+    memset(out, 0, sizeof(*out));
+    if (in->data.size > PSN_MAX_BODY || (in->data.size && !in->data.data) ||
+        in->ext_data_count > PSN_MAX_EXT_DATA || (in->ext_data_count && !in->ext_data) ||
+        !memchr(in->from_online_id, 0, sizeof(in->from_online_id)) ||
+        !memchr(in->to_online_id, 0, sizeof(in->to_online_id)) ||
+        (in->service && !copy_text(out->service, sizeof(out->service), in->service)) ||
+        !copy_text(out->type, sizeof(out->type), in->data_type))
+        return PSN_INVALID_ARGUMENT;
+    size_t total = (size_t)in->data.size;
+    for (uint32_t i = 0; i < in->ext_data_count; ++i) {
+        const PsnExtData *e = &in->ext_data[i];
+        if (e->value.size > PSN_MAX_BODY - total || (e->value.size && !e->value.data) ||
+            !copy_text(out->keys[i], sizeof(out->keys[i]), e->key))
+            return PSN_INVALID_ARGUMENT;
+        total += (size_t)e->value.size;
+    }
+    out->payload = malloc(total ? total : 1);
+    if (!out->payload)
+        return PSN_BACKEND_NO_MEMORY;
+    unsigned char *p = out->payload;
+    out->event = *in;
+    out->event.service = in->service ? out->service : NULL;
+    out->event.data_type = out->type;
+    out->event.ext_data = out->ext;
+    if (in->data.size)
+        memcpy(p, in->data.data, (size_t)in->data.size);
+    out->event.data.data = p;
+    p += in->data.size;
+    for (uint32_t i = 0; i < in->ext_data_count; ++i) {
+        out->ext[i].key = out->keys[i];
+        out->ext[i].value = (PsnBytes){p, in->ext_data[i].value.size};
+        if (out->ext[i].value.size)
+            memcpy(p, in->ext_data[i].value.data, (size_t)out->ext[i].value.size);
+        p += out->ext[i].value.size;
+    }
+    return 0;
+}
+static int32_t queue_invitation(const PsnSessionInvitation *invite) {
+    if (!invite->session_id[0] || !memchr(invite->session_id, 0, sizeof(invite->session_id)) ||
+        !memchr(invite->invitation_id, 0, sizeof(invite->invitation_id)) ||
+        !memchr(invite->accepting_online_id, 0, sizeof(invite->accepting_online_id)) ||
+        !memchr(invite->referring_online_id, 0, sizeof(invite->referring_online_id)) ||
+        !psn_host_has_local_user(invite->accepting_user_id))
+        return PSN_INVALID_ARGUMENT;
+    pthread_mutex_lock(&system_mutex);
+    int32_t result = PSN_BACKEND_BUSY;
+    if (invitation_count < INVITE_CAPACITY) {
+        invitations[(invitation_head + invitation_count++) % INVITE_CAPACITY] = *invite;
+        result = 0;
+    }
+    pthread_mutex_unlock(&system_mutex);
+    return result;
+}
+int32_t psn_host_pump(void) {
+    if (!psn_host_selected())
+        return 0;
+    if (pthread_mutex_trylock(&pump_mutex))
+        return 0;
+    int32_t result = 0;
+    /* Bound work per guest pump, not session duration. Overflow/fault is explicit. */
+    for (unsigned i = 0; i < 64; ++i) {
+        PsnEvent event = {0};
+        CopiedPush copy = {0};
+        void *ctx;
+        const PsnBackendV1 *b = psn_host_lock(&ctx);
+        if (failure)
+            result = failure;
+        else
+            result = b ? b->event_next(ctx, &event) : PSN_BACKEND_UNAVAILABLE;
+        if (result == 1 && event.kind == 2) {
+            result = copy_push(&copy, &event.data.push);
+            if (!result)
+                result = 1;
+        }
+        psn_host_unlock();
+        if (result != 1) {
+            free(copy.payload);
+            break;
+        }
+        result = 0;
+        switch (event.kind) {
+        case 1:
+            if ((event.data.identity.state != 1 && event.data.identity.state != 2) ||
+                !memchr(event.data.identity.online_id, 0, sizeof(event.data.identity.online_id)))
+                result = PSN_INVALID_ARGUMENT;
+            else
+                result = psn_host_identity_event(&event);
+            break;
+        case 2:
+            result = psn_host_webapi_event(&copy.event);
+            break;
+        case 3:
+            result = queue_invitation(&event.data.invitation);
+            break;
+        case 4:
+        case 5:
+        case 6:
+            result = psn_host_identity_event(&event);
+            break;
+        default:
+            result = PSN_BACKEND_UNSUPPORTED;
+            break;
+        }
+        free(copy.payload);
+        if (result)
+            break;
+    }
+    if (result < 0) {
+        pthread_mutex_lock(&backend_mutex);
+        failure = result;
+        pthread_mutex_unlock(&backend_mutex);
+        fputs("PSN backend: event delivery failed; the selected session remains failed.\n", stderr);
+    }
+    pthread_mutex_unlock(&pump_mutex);
+    return result;
+}
+
+int32_t psn_host_system_count(void) {
+    int32_t result = psn_host_pump();
+    if (result < 0)
+        return result;
+    pthread_mutex_lock(&system_mutex);
+    int32_t count = (int32_t)invitation_count;
+    pthread_mutex_unlock(&system_mutex);
+    return count;
+}
+int32_t psn_host_system_receive(void *event) {
+    if (!event)
+        return (int32_t)0x80a10003;
+    int32_t result = psn_host_pump();
+    if (result < 0)
+        return result;
+    pthread_mutex_lock(&system_mutex);
+    if (!invitation_count) {
+        pthread_mutex_unlock(&system_mutex);
+        return (int32_t)0x80a10004;
+    }
+    PsnSessionInvitation invite = invitations[invitation_head];
+    invitation_head = (invitation_head + 1) % INVITE_CAPACITY;
+    --invitation_count;
+    pthread_mutex_unlock(&system_mutex);
+    /* Guest event param is 176 bytes. Use memcpy: param starts at event+4 and contains u64. */
+    unsigned char *e = event, *p = e + 4;
+    memset(e, 0, 4 + 176);
+    const int32_t kind = 0x10000002;
+    memcpy(e, &kind, 4);
+    memcpy(p, invite.session_id, strlen(invite.session_id));
+    memcpy(p + 48, invite.invitation_id, strlen(invite.invitation_id));
+    memcpy(p + 112, &invite.flag, 4);
+    memcpy(p + 120, invite.accepting_online_id, strlen(invite.accepting_online_id));
+    memcpy(p + 140, &invite.accepting_user_id, 4);
+    memcpy(p + 144, invite.referring_online_id, strlen(invite.referring_online_id));
+    memcpy(p + 168, &invite.referring_account_id, 8);
+    return 0;
+}
+static PSN_GUEST_ABI int64_t unsupported(void) {
+    fputs("PSN backend: this guest NP operation is outside the supported host profile.\n", stderr);
+    return PSN_BACKEND_UNSUPPORTED;
+}
+uintptr_t psn_host_resolve(const char *name) {
+    if (!psn_host_selected())
+        return 0;
+    /* Local trophy storage/UI remains the host's responsibility in every mode. */
+    if (name && !strncmp(name, "sceNpTrophy", 11))
+        return 0;
+    /* The existing host's local JSON-to-NpId utility has no backend state. */
+    if (name && !strcmp(name, "sceNpWebApiUtilityParseNpId"))
+        return 0;
+    uintptr_t fn = psn_host_identity_resolve(name);
+    if (fn)
+        return fn;
+    fn = psn_host_webapi_resolve(name);
+    if (fn)
+        return fn;
+    const char *symbol = name;
+    if (symbol && (!strncmp(symbol, "sceNp", 5) || !strncmp(symbol, "sceInvitationDialog", 19)))
+        return (uintptr_t)unsupported;
+    return 0;
+}
diff --git a/platform/psn/psn_host.h b/platform/psn/psn_host.h
new file mode 100644
index 0000000000000000000000000000000000000000..7d542a608f0138c3f31336ccc48de655801d23cf
--- /dev/null
+++ b/platform/psn/psn_host.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PSN_HOST_H
+#define PSN_HOST_H
+#include "include/psn_backend.h"
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <time.h>
+
+/* PS4 guests use x86-64 System V even when the provider uses the Windows ABI.
+ * This module deliberately has no dependency on any bbport runtime header. */
+#define PSN_GUEST_ABI __attribute__((sysv_abi))
+typedef struct {
+    const char *name;
+    void *function;
+} PsnHostExport;
+static inline uintptr_t psn_host_lookup(const PsnHostExport *table, size_t count,
+                                        const char *symbol) {
+    if (!symbol)
+        return 0;
+    for (size_t i = 0; i < count; ++i)
+        if (!strcmp(symbol, table[i].name))
+            return (uintptr_t)table[i].function;
+    return 0;
+}
+#define PSN_LOOKUP(table, symbol) psn_host_lookup(table, sizeof(table) / sizeof(*(table)), symbol)
+
+/* Internal host adapter. Backend lock serializes native calls, never guest callbacks.
+ * Module registry locks may nest the backend lock; the core releases its lock before
+ * delivering events to either module. Resolver functions are only used in external mode. */
+/* Local user IDs belong to the integrating host, not the platform provider. Copy a
+ * process-lifetime set before start(); IDs are opaque nonnegative values, not slot
+ * numbers. Local login state is still reported by identity(), never inferred here. */
+#define PSN_MAX_LOCAL_USERS 4u
+int32_t psn_host_set_local_users(const int32_t *users, uint32_t count);
+uint32_t psn_host_local_users(int32_t users[PSN_MAX_LOCAL_USERS]);
+int psn_host_has_local_user(int32_t user);
+int psn_host_selected(void);
+int psn_host_start(void);
+void psn_host_stop(void);
+const PsnBackendV1 *psn_host_lock(void **instance);
+void psn_host_unlock(void);
+int32_t psn_host_pump(void);
+uintptr_t psn_host_resolve(const char *name);
+
+uintptr_t psn_host_identity_resolve(const char *name);
+int32_t psn_host_identity_event(const PsnEvent *event);
+void psn_host_identity_dispatch(void);
+void psn_host_identity_reset(void);
+uintptr_t psn_host_webapi_resolve(const char *name);
+int32_t psn_host_webapi_event(const PsnPushEvent *event);
+void psn_host_webapi_dispatch(void);
+void psn_host_webapi_reset(void);
+
+/* Host-owned SystemService queue. Calling count/receive pumps copied backend events. */
+int32_t psn_host_system_count(void);
+int32_t psn_host_system_receive(void *event);
+#endif
diff --git a/platform/psn/psn_identity.c b/platform/psn/psn_identity.c
new file mode 100644
index 0000000000000000000000000000000000000000..2a920ea2301990c9dbbccfb55f0d21ec37f7f15b
--- /dev/null
+++ b/platform/psn/psn_identity.c
@@ -0,0 +1,1220 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Optional PS4 NP guest adapter. This file owns guest handles and memory; the
+ * native backend receives only copied values. The built-in RyuNET path never
+ * enters this resolver. Structure layouts are checked against public PS4
+ * compatibility references; no Sony service or credential format is assumed. */
+#include "psn_host.h"
+#include <limits.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define NP_USER_NOT_FOUND ((int32_t)0x80550007)
+#define NP_CALLBACK_REGISTERED ((int32_t)0x80550008)
+#define NP_CALLBACK_MISSING ((int32_t)0x80550009)
+#define NP_CALLBACK_MAX ((int32_t)0x8055001D)
+#define NP_INVALID_SIZE ((int32_t)0x80550011)
+#define NP_ABORTED ((int32_t)0x80550012)
+#define NP_REQUEST_MAX ((int32_t)0x80550013)
+#define NP_REQUEST_MISSING ((int32_t)0x80550014)
+#define NP_INVALID_ID ((int32_t)0x80550015)
+#define AUTH_INVALID_ARGUMENT ((int32_t)0x80550301)
+#define AUTH_INVALID_SIZE ((int32_t)0x80550302)
+#define AUTH_ABORTED ((int32_t)0x80550304)
+#define AUTH_REQUEST_MAX ((int32_t)0x80550305)
+#define AUTH_REQUEST_MISSING ((int32_t)0x80550306)
+#define AUTH_INVALID_ID ((int32_t)0x80550307)
+#define DIALOG_ERROR(n) ((int32_t)(0x80B80000u + (n)))
+
+typedef struct {
+    char data[16], term, padding[3];
+} GuestOnlineId;
+typedef struct {
+    GuestOnlineId online;
+    uint8_t options[8], reserved[8];
+} GuestNpId;
+typedef struct {
+    uint64_t size, affinity;
+    int32_t priority;
+    uint32_t padding;
+} GuestAsync;
+typedef struct {
+    uint64_t size;
+    union {
+        const GuestOnlineId *online;
+        struct {
+            int32_t user;
+            uint32_t pad;
+        };
+    } identity;
+    const char *client;
+    const char *secret_or_scope;
+    const char *scope;
+} GuestAuth;
+typedef struct {
+    uint64_t size;
+    int32_t user;
+    uint32_t padding;
+    uint64_t features;
+    uint8_t reserved[32];
+} GuestPlus;
+_Static_assert(sizeof(GuestOnlineId) == 20, "NP online ID layout");
+_Static_assert(sizeof(GuestNpId) == 36, "NP ID layout");
+_Static_assert(sizeof(GuestAuth) == 40, "ID token parameter layout");
+_Static_assert(offsetof(GuestAuth, client) == 16, "auth client offset");
