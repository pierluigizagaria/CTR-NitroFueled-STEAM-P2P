diff --git a/tests/test_psn_backend_v075.py b/tests/test_psn_backend_v075.py
new file mode 100644
index 0000000000000000000000000000000000000000..d55710a423c13fc2b7380fbac9945dead4d614b1
--- /dev/null
+++ b/tests/test_psn_backend_v075.py
@@ -0,0 +1,142 @@
+"""Keep OCTR's optional RyuNET modes and report upload outside external sessions."""
+import ast
+import contextlib
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+from paths import ROOT
+sys.path.insert(0, str(ROOT))
+import run
+import perf_report
+
+
+class ExternalLaunchTests(unittest.TestCase):
+    def test_external_setup_clears_mode_state_and_exports_clears_to_shell(self):
+        keys = ('BB_ITEM_RULES', 'BB_SPEED_MODE', 'BB_SPEED_SOLO_TEST', 'BB_ONLINE_MODE_HOOK',
+                'BB_PRIVATE_ARCHIVE_PATCHES', 'BB_KNOWN_HEROES')
+        with tempfile.TemporaryDirectory() as tmp:
+            data = Path(tmp)
+            library = data / 'backend.dll'
+            library.write_bytes(b'fixture: never loaded')
+            config = data / 'bbport.ini'
+            config.write_text('online=1\nonline_server=127.0.0.1:8090\n', encoding='utf-8')
+            env = dict.fromkeys(keys, 'stale') | {'BB_PSN_BACKEND': str(library)}
+            with mock.patch.object(run, 'ryunet_json', side_effect=AssertionError('RyuNET request')), \
+                    mock.patch.object(run, 'online_key', side_effect=AssertionError('RyuNET key')), \
+                    contextlib.redirect_stdout(io.StringIO()):
+                run.setup_online(env, config, data)
+            self.assertEqual({key: env[key] for key in keys}, dict.fromkeys(keys, ''))
+            self.assertEqual(env['BB_ONLINE_SERVER'], '127.0.0.1')
+            output = data / 'environment'
+            child = subprocess.run([sys.executable, str(ROOT / 'scripts/online_config.py'),
+                                    '--config', str(config), '--data', str(data), '--env-file', str(output)],
+                                   env=os.environ | env | dict.fromkeys(keys, 'stale'),
+                                   capture_output=True, text=True)
+            self.assertEqual(child.returncode, 0, child.stderr)
+            exported = dict(item.decode().split('=', 1) for item in output.read_bytes().split(b'\0') if item)
+            self.assertEqual({key: exported[key] for key in keys}, dict.fromkeys(keys, ''))
+            self.assertNotIn('BB_PSN_BACKEND', exported)
+
+    def test_upstream_item_rules_still_come_from_server(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            data = Path(tmp)
+            config = data / 'bbport.ini'
+            config.write_text('online=1\nonline_name=PlayerOne\nonline_server=127.0.0.1:8090\n', encoding='utf-8')
+            rules = {'name': 'fixture-rules', 'odds': {'rocket': 3}}
+            env = {'BB_ITEM_RULES': 'stale', 'BB_SPEED_MODE': '1'}
+            with mock.patch.object(run, 'server_settings', return_value={'items': rules}), \
+                    mock.patch.object(run, 'online_key', return_value=None), \
+                    contextlib.redirect_stdout(io.StringIO()):
+                run.setup_online(env, config, data)
+            self.assertEqual(json.loads(Path(env['BB_ITEM_RULES']).read_text()), rules)
+            self.assertNotIn('BB_SPEED_MODE', env)
+
+    def test_layout_prepares_modes_only_for_upstream_backend(self):
+        tree = ast.parse((ROOT / 'run.py').read_text(encoding='utf-8'))
+        main = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == 'main')
+        layout = next(node for node in ast.walk(main) if isinstance(node, ast.FunctionDef) and node.name == 'apply_layout')
+        for selector in ('/external/backend', ''):
+            with self.subTest(selector=selector):
+                env = {'BB_PSN_BACKEND': selector, 'BB_ONLINE': '1', 'BB_SPEED_SOLO_TEST': '1',
+                       'BB_PRIVATE_ARCHIVE_PATCHES': 'stale', 'BB_ONLINE_MODE_HOOK': 'stale'}
+                online = SimpleNamespace(prepare=mock.Mock(return_value=([Path('menu.patch')], 'hook')),
+                                         known_heroes=mock.Mock(return_value='heroes'))
+                speed = SimpleNamespace(prepare=mock.Mock(return_value=([Path('normal.patch')], [Path('speed.patch')], 1)))
+                namespace = dict(env=env, layout_saved={}, game=Path('game'), out=Path('out'), config='settings',
+                                 title_id='CUSA13795', app_version='01.21', base_patches=[], Path=Path,
+                                 aspect_ratio=SimpleNamespace(prepare=lambda *args: None,
+                                                              archive_list=lambda *args: 'base.patch'),
+                                 mod_packages=SimpleNamespace(ACTIVE=False), online_mode=online, speed_mode=speed,
+                                 external_psn_backend=run.external_psn_backend, say=lambda *args: None)
+                exec(compile(ast.Module(body=[layout], type_ignores=[]), 'run.py', 'exec'), namespace)
+                self.assertEqual(namespace['apply_layout'](), ('settings', None))
+                if selector:
+                    online.prepare.assert_not_called()
+                    speed.prepare.assert_not_called()
+                    self.assertNotIn('BB_ONLINE_MODE_HOOK', env)
+                    self.assertNotIn('BB_PRIVATE_ARCHIVE_PATCHES', env)
+                    self.assertEqual(env['BB_ARCHIVE_PATCHES'], 'base.patch')
+                else:
+                    online.prepare.assert_called_once()
+                    speed.prepare.assert_called_once()
+                    self.assertEqual(env['BB_ONLINE_MODE_HOOK'], 'hook')
+                    self.assertEqual(env['BB_PRIVATE_ARCHIVE_PATCHES'], 'speed.patch')
+
+    def test_shell_external_launch_skips_mode_preparation(self):
+        msys = os.environ.get('MSYS2_ROOT')
+        bash = str(Path(msys) / 'usr/bin/bash.exe') if os.name == 'nt' and msys else shutil.which('bash')
+        if not bash or (os.name == 'nt' and not msys):
+            self.skipTest('A project-selected MSYS2 bash is required on Windows')
+        script = (ROOT / 'run.sh').read_text(encoding='utf-8')
+        block = script[script.index('unset BB_ONLINE_MODE_HOOK BB_SPEED_MODE'):
+                       script.index('# The game runs at its own 30 FPS')]
+        fixture = '''set -eu
+prepare_test() { echo 'unexpected mode preparation' >&2; return 1; }
+PYTHON=prepare_test
+BB_PSN_BACKEND=/external/backend BB_ONLINE=1 BB_SPEED_SOLO_TEST=1
+BB_ONLINE_MODE_HOOK=stale BB_SPEED_MODE=1
+title_id=CUSA13795 app_version=01.21
+'''
+        result = subprocess.run([bash, '--noprofile', '--norc', '-c', fixture + block +
+                                 '\n[[ -z ${BB_ONLINE_MODE_HOOK:-} && -z ${BB_SPEED_MODE:-} ]]'],
+                                capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn('unexpected', result.stderr)
+
+
+class PerformanceIsolationTests(unittest.TestCase):
+    def test_both_finalizers_keep_reports_but_only_upstream_uploads(self):
+        for shell in (False, True):
+            for selector in ('/external/backend', ''):
+                with self.subTest(shell=shell, selector=selector), tempfile.TemporaryDirectory() as tmp:
+                    data = Path(tmp)
+                    config = data / 'bbport.ini'
+                    config.write_text('perf_reports=1\nonline_server=127.0.0.1:8090\n', encoding='utf-8')
+                    state = data / 'state.json'
+                    state.write_text('{}', encoding='utf-8')
+                    collector = SimpleNamespace(report=lambda metadata: {'fault': {'kind': 'fixture'}} | metadata)
+                    env = {'BB_PSN_BACKEND': selector, 'BB_ONLINE_SERVER': '127.0.0.1',
+                           'BB_ONLINE_HTTP_PORT': '8090'}
+                    with mock.patch.object(run, 'PERF', collector), \
+                            mock.patch.object(perf_report, '_collector_of', return_value=collector), \
+                            mock.patch.object(run, 'ryunet_json', return_value=({}, None)) as upload, \
+                            mock.patch.dict(os.environ, env), contextlib.redirect_stdout(io.StringIO()):
+                        if shell:
+                            perf_report.finish(state, 0, config, data, 'v0.7.5', 'CUSA13795')
+                        else:
+                            run.finish_perf_report(env, config, data, 'v0.7.5', 'CUSA13795', 0)
+                    self.assertTrue(list((data / 'perf').glob('*.json')))
+                    self.assertEqual(upload.call_count, 0 if selector else 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_room_mode_isolation.c b/tests/test_room_mode_isolation.c
new file mode 100644
index 0000000000000000000000000000000000000000..403102293c8c048609de2078d3e3446be2a123d0
