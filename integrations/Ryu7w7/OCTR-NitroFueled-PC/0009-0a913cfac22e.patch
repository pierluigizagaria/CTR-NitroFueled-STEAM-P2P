+++ b/tests/test_room_mode_isolation.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Execute the real room callbacks with synchronous threads and a local request
+ * fixture. No guest memory, publisher or network connection is used. */
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+static int fixture_create(pthread_t *, const pthread_attr_t *, void *(*)(void *), void *);
+static int fixture_detach(pthread_t);
+static int fixture_sleep(const struct timespec *, struct timespec *);
+#define pthread_create fixture_create
+#define pthread_detach fixture_detach
+#define nanosleep fixture_sleep
+#include "../src/runtime_room_mode.c"
+#undef pthread_create
+#undef pthread_detach
+#undef nanosleep
+
+void (*runtime_online_mode_chosen)(int, int);
+static int selected, threads, detached, requests, leaves, changes, adopts, sleeps;
+static int private_speed = 1, in_private = 1, adopted = -1, changed = -1;
+static char method_seen[8], target_seen[160];
+
+int runtime_psn_selected(void) { return selected; }
+const char *runtime_np_get_online_name(void) { return "PlayerOne"; }
+int runtime_online_mode_private_speed(void) { return private_speed; }
+int runtime_online_mode_in_private(void) { return in_private; }
+void runtime_online_mode_leave_cup(void) { ++leaves; }
+void runtime_speed_mode_set(int enabled) { ++changes; changed = enabled; }
+void runtime_online_mode_adopt(int speed) { ++adopts; adopted = speed; }
+int runtime_ryunet_request(const char *method, const char *target, char *body, size_t capacity) {
+    ++requests;
+    snprintf(method_seen, sizeof method_seen, "%s", method);
+    snprintf(target_seen, sizeof target_seen, "%s", target);
+    snprintf(body, capacity, "mode speed");
+    return 200;
+}
+
+static int fixture_create(pthread_t *thread, const pthread_attr_t *attr,
+                          void *(*run)(void *), void *arg) {
+    (void)attr;
+    *thread = (pthread_t)0;
+    ++threads;
+    run(arg);
+    return 0;
+}
+static int fixture_detach(pthread_t thread) { (void)thread; ++detached; return 0; }
+static int fixture_sleep(const struct timespec *request, struct timespec *remaining) {
+    (void)request;
+    (void)remaining;
+    ++sleeps;
+    runtime_room_mode_left(); /* Stop the synchronous follower after one response. */
+    return 0;
+}
+
+static void clear_counts(void) {
+    threads = detached = requests = leaves = changes = adopts = sleeps = 0;
+    method_seen[0] = target_seen[0] = '\0';
+    adopted = changed = -1;
+}
+
+int main(void) {
+    assert(runtime_online_mode_chosen); /* The production constructor registered it. */
+    selected = 1;
+    const unsigned before = follow_generation;
+    runtime_room_mode_hosting();
+    runtime_room_mode_joined("cusa13795-session-OtherPlayer");
+    runtime_room_mode_left();
+    runtime_online_mode_chosen(1, 1);
+    runtime_online_mode_chosen(0, 0);
+    assert(!threads && !detached && !requests && !leaves && !changes && !adopts && !sleeps);
+    assert(follow_generation == before);
+
+    selected = 0;
+    runtime_room_mode_hosting();
+    assert(threads == 1 && detached == 1 && requests == 1 && leaves == 1 && changes == 1);
+    assert(changed == 1 && !strcmp(method_seen, "POST"));
+    assert(!strcmp(target_seen, "/ryunet/room-mode?name=PlayerOne&mode=speed&format=text"));
+
+    clear_counts();
+    runtime_online_mode_chosen(1, 0); /* Public search must publish Normal. */
+    assert(threads == 1 && requests == 1 && leaves == 1 && changes == 1);
+    assert(!strcmp(target_seen, "/ryunet/room-mode?name=PlayerOne&mode=normal&format=text"));
+
+    clear_counts();
+    runtime_room_mode_joined("cusa13795-session-OtherPlayer");
+    assert(threads == 1 && detached == 1 && requests == 1 && sleeps == 1);
+    assert(adopts == 1 && adopted == 1 && leaves == 1 && changes == 1);
+    assert(!strcmp(method_seen, "GET"));
+    assert(!strcmp(target_seen, "/ryunet/room-mode?host=OtherPlayer&format=text"));
+
+    clear_counts();
+    runtime_room_mode_joined("cusa13795-session-PlayerOne");
+    runtime_room_mode_joined("cusa13795-session-Bad Name");
+    runtime_room_mode_joined("external-session");
+    runtime_room_mode_joined(NULL);
+    assert(!threads && !requests && !changes);
+    puts("Room mode isolation tests passed");
+    return 0;
+}
