+"""OCTR client metadata belongs to RyuNET, including the late launch stage."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+from paths import ROOT
+import run
+
+
+class ClientMetadataTests(unittest.TestCase):
+    def test_external_launch_clears_inherited_metadata_without_collecting_machine_id(self):
+        env = {'BB_PSN_BACKEND': '/external/backend', 'BB_MACHINE_ID': 'stale', 'BB_OCTR_VERSION': 'old'}
+        with mock.patch.object(run, 'machine_header', side_effect=AssertionError('machine fingerprint')), \
+                mock.patch.dict(os.environ, {'BB_PSN_BACKEND': ''}):
+            run.set_ryunet_client_metadata(env, 'v0.8.3')
+        self.assertEqual(env['BB_MACHINE_ID'], '')
+        self.assertEqual(env['BB_OCTR_VERSION'], '')
+
+    def test_upstream_launch_still_collects_metadata_from_its_own_environment(self):
+        for selector in (None, ''):
+            with self.subTest(selector=selector):
+                env = {} if selector is None else {'BB_PSN_BACKEND': selector}
+                with mock.patch.object(run, 'machine_header', return_value='fixture-machine') as fingerprint, \
+                        mock.patch.dict(os.environ, {'BB_PSN_BACKEND': '/another/process/backend'}):
+                    run.set_ryunet_client_metadata(env, 'v0.8.3-12-gabcdef')
+                fingerprint.assert_called_once_with()
+                self.assertEqual(env['BB_MACHINE_ID'], 'fixture-machine')
+                self.assertEqual(env['BB_OCTR_VERSION'], '0.8.3')
+
+    def test_shell_late_metadata_only_collects_for_upstream(self):
+        msys = os.environ.get('MSYS2_ROOT')
+        bash = str(Path(msys) / 'usr/bin/bash.exe') if os.name == 'nt' and msys else shutil.which('bash')
+        if not bash or (os.name == 'nt' and not msys):
+            self.skipTest('A project-selected MSYS2 bash is required on Windows')
+        script = (ROOT / 'run.sh').read_text(encoding='utf-8')
+        block = script[script.index('# Client metadata and the machine fingerprint'):
+                       script.index('# Mod packages (the launcher')]
+        fixture = '''set -eu
+fingerprint_test() { printf called > "$FINGERPRINT_TEST_MARKER"; printf 'fixture-machine\\n'; }
+PYTHON=fingerprint_test version=v0.8.3-12-gabcdef
+BB_MACHINE_ID=stale BB_OCTR_VERSION=old
+'''
+        for selector in ('/external/backend', ''):
+            with self.subTest(selector=selector), tempfile.TemporaryDirectory() as tmp:
+                marker = Path(tmp) / 'fingerprint-called'
+                expected = ('[[ -z $BB_MACHINE_ID && -z $BB_OCTR_VERSION ]]' if selector else
+                            '[[ $BB_MACHINE_ID == fixture-machine && $BB_OCTR_VERSION == 0.8.3 ]]')
+                result = subprocess.run([bash, '--noprofile', '--norc', '-c', fixture + block + '\n' + expected],
+                                        env=os.environ | {'BB_PSN_BACKEND': selector,
+                                                          'FINGERPRINT_TEST_MARKER': marker.as_posix()},
+                                        capture_output=True, text=True)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(marker.exists(), not bool(selector))
+
+
+if __name__ == '__main__':
+    unittest.main()
