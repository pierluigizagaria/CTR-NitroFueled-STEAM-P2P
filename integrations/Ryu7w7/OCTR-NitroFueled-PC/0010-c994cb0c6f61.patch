+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Link the real chat, name-color and spectate clients, intercepting worker creation.
+ * Verify external isolation and ordinary startup without a game or network. */
+#define _POSIX_C_SOURCE 200809L
+#include "runtime.h"
+#include "runtime_chat.h"
+#include "runtime_name_colors.h"
+#include "runtime_net_ping.h"
+#include "runtime_replay.h"
+#include "runtime_replay_list.h"
+#include "runtime_spectate.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+
+static int external = 1, threads, detached, game_reads;
+int runtime_psn_selected(void) { return external; }
+int fixture_thread_create(pthread_t *thread, const pthread_attr_t *attr,
+                          void *(*run)(void *), void *arg) {
+    (void)attr; (void)arg;
+    assert(run);
+    *thread = (pthread_t)0;
+    ++threads;
+    return 0;
+}
+int fixture_thread_detach(pthread_t thread) { (void)thread; ++detached; return 0; }
+int runtime_online_mode_room_on(void) { ++game_reads; return 1; }
+int runtime_online_mode_public_on(void) { ++game_reads; return 0; }
+int runtime_room_mode_following(void) { return 0; }
+void runtime_room_mode_host_name(char out[24]) { snprintf(out, 24, "PlayerOne"); }
+const char *runtime_np_get_online_name(void) { return "PlayerOne"; }
+const char *runtime_file_progress_dir(void) { assert(!"unexpected file access"); return "."; }
+int runtime_net_ping_view(PingPeer *out, int max) { (void)out; (void)max; return 0; }
+int runtime_ryunet_transfer(const char *method, const char *target, const void *data, size_t size,
+                            char **reply, size_t *reply_size, size_t max_reply) {
+    (void)method; (void)target; (void)data; (void)size; (void)reply; (void)reply_size; (void)max_reply;
+    assert(!"unexpected network request");
+    return 0;
+}
+int runtime_replay_chat_allowed(void) { return 1; }
+int runtime_replay_can_start(void) { return 1; }
+int runtime_replay_can_chain(void) { return 0; }
+uint32_t runtime_replay_live_count(void) { return 0; }
+int runtime_replay_live_state(uint32_t *id, struct rr_header *header, uint32_t *frames, int *ended) {
+    (void)id; (void)header; (void)frames; (void)ended; return 0;
+}
+size_t runtime_replay_live_pack(uint32_t id, uint32_t from, uint32_t to, uint8_t *out, size_t cap) {
+    (void)id; (void)from; (void)to; (void)out; (void)cap; return 0;
+}
+int runtime_replay_play_live(const struct rr_header *header, const uint8_t *packed, size_t size, uint32_t frames) {
+    (void)header; (void)packed; (void)size; (void)frames; return 0;
+}
+int runtime_replay_live_append(const struct rr_header *header, const uint8_t *packed, size_t size,
+                               uint32_t frames, int ended) {
+    (void)header; (void)packed; (void)size; (void)frames; (void)ended; return 0;
+}
+
+static void start_services(void) {
+    runtime_chat_start();
+    runtime_spectate_start();
+    runtime_name_colors_start();
+}
+
+int main(void) {
+    start_services();
+    start_services();
+    assert(!threads && !detached);
+    assert(!runtime_chat_available() && !runtime_chat_send("hello"));
+    assert(!game_reads);
+    runtime_spectate_watch("OtherPlayer");
+    char who[32] = "unchanged";
+    int state = -1;
+    assert(!runtime_spectate_following(who, sizeof who) && !who[0]);
+    assert(runtime_spectate_status(&state, who, sizeof who) == 0 && state == RS_IDLE && !who[0]);
+    assert(!runtime_spectate_viewers());
+    float rgb[3] = {-1, -1, -1};
+    assert(!runtime_name_color("Ryu7w7", rgb));
+    assert(rgb[0] == -1 && rgb[1] == -1 && rgb[2] == -1);
+
+    /* Suppressed startup must not latch a client's once-only startup flag. */
+    external = 0;
+    start_services();
+    assert(threads == 3 && detached == 3);
+    start_services();
+    assert(threads == 3 && detached == 3);
+    assert(runtime_chat_available() && runtime_chat_send("hello") && game_reads > 0);
+    assert(runtime_name_color("Ryu7w7", rgb));
+    runtime_spectate_watch("OtherPlayer");
+    assert(runtime_spectate_following(who, sizeof who) && !strcmp(who, "OtherPlayer"));
+    assert(runtime_spectate_status(&state, who, sizeof who) == 1 && state == RS_FETCHING);
+    runtime_spectate_stop();
+    assert(!runtime_spectate_following(who, sizeof who));
+    puts("RyuNET service isolation tests passed");
+    return 0;
+}
