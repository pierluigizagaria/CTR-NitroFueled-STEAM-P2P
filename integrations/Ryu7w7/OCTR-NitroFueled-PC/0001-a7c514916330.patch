+    if (!handle)
+        result = WEB_NO_HANDLE;
+    for (Filter *filter = filters; !result && filter; filter = filter->next)
+        if (filter->library == lib && filter->handle == id)
+            result = WEB_ERROR(25);
+    if (!result) {
+        Handle **link = &handles;
+        while (*link != handle)
+            link = &(*link)->next;
+        *link = handle->next;
+        free(handle);
+    }
+    pthread_mutex_unlock(&web_lock);
+    return result;
+}
+static int32_t create_filter(int32_t lib, int32_t handle, const char *service, uint32_t label,
+                             const void *parameters, uint64_t count, uint32_t kind) {
+    if (!parameters || !count || count > MAX_FILTER_PARAMS ||
+        (service && strnlen(service, 256) > 255))
+        return WEB_INVALID;
+    Filter *filter = calloc(1, sizeof(*filter));
+    if (!filter)
+        return WEB_NOMEM;
+    if (service) {
+        filter->service = copy_string(service, 255);
+        if (!filter->service) {
+            free(filter);
+            return WEB_NOMEM;
+        }
+    }
+    filter->library = lib;
+    filter->handle = handle;
+    filter->label = service ? label : UINT32_MAX;
+    filter->kind = kind;
+    filter->count = (uint32_t)count;
+    for (uint32_t i = 0; i < count; i++) {
+        const GuestExtFilter *ext = kind == 3 ? &((const GuestExtFilter *)parameters)[i] : NULL;
+        const GuestDataType *type = ext ? &ext->type : &((const GuestDataType *)parameters)[i];
+        if (strnlen(type->value, 65) > 64 ||
+            (ext && (ext->count > PSN_MAX_EXT_DATA || (ext->count && !ext->keys)))) {
+            free(filter->service);
+            free(filter);
+            return WEB_INVALID;
+        }
+        memcpy(filter->params[i].type, type->value, strlen(type->value) + 1);
+        if (ext) {
+            filter->params[i].key_count = (uint32_t)ext->count;
+            for (uint32_t k = 0; k < ext->count; k++) {
+                if (strnlen(ext->keys[k].value, 33) > 32) {
+                    free(filter->service);
+                    free(filter);
+                    return WEB_INVALID;
+                }
+                memcpy(filter->params[i].keys[k], ext->keys[k].value,
+                       strlen(ext->keys[k].value) + 1);
+            }
+        }
+    }
+    /* Filter parameters are an OR-list. Duplicate data types must not produce
+     * duplicate subscriptions and callback delivery for the same registration. */
+    for (uint32_t i = 0; i < filter->count; i++)
+        for (uint32_t j = i + 1; j < filter->count;) {
+            if (strcmp(filter->params[i].type, filter->params[j].type)) {
+                j++;
+                continue;
+            }
+            FilterParam *target = &filter->params[i], *source = &filter->params[j];
+            for (uint32_t k = 0; k < source->key_count; k++) {
+                uint32_t n = 0;
+                while (n < target->key_count && strcmp(target->keys[n], source->keys[k]))
+                    n++;
+                if (n == target->key_count) {
+                    if (n == PSN_MAX_EXT_DATA) {
+                        free(filter->service);
+                        free(filter);
+                        return WEB_INVALID;
+                    }
+                    memcpy(target->keys[target->key_count++], source->keys[k], 33);
+                }
+            }
+            memmove(&filter->params[j], &filter->params[j + 1],
+                    (filter->count - j - 1) * sizeof(filter->params[0]));
+            filter->count--;
+        }
+    pthread_mutex_lock(&web_lock);
+    int32_t result = 0;
+    unsigned existing = 0;
+    for (Filter *f = filters; f; f = f->next)
+        existing++;
+    if (!find_library(lib))
+        result = WEB_NO_LIB;
+    else if (kind != 1 && !find_handle(lib, handle))
+        result = WEB_NO_HANDLE;
+    else if (existing >= MAX_OBJECTS)
+        result = WEB_NOMEM;
+    if (result) {
+        free(filter->service);
+        free(filter);
+    } else {
+        filter->id = allocate_id();
+        filter->next = filters;
+        filters = filter;
+        result = filter->id;
+    }
+    pthread_mutex_unlock(&web_lock);
+    return result;
+}
+static PSN_GUEST_ABI int32_t web_create_basic_filter(int32_t lib, const GuestDataType *params,
+                                                     uint64_t count) {
+    return create_filter(lib, 0, NULL, UINT32_MAX, params, count, 1);
+}
+static PSN_GUEST_ABI int32_t web_create_service_filter(int32_t lib, int32_t handle,
+                                                       const char *service, uint32_t label,
+                                                       const GuestDataType *params,
+                                                       uint64_t count) {
+    if (!service || label == UINT32_MAX)
+        return WEB_INVALID;
+    return create_filter(lib, handle, service, label, params, count, 2);
+}
+static PSN_GUEST_ABI int32_t web_create_ext_filter(int32_t lib, int32_t handle, const char *service,
+                                                   uint32_t label, const GuestExtFilter *params,
+                                                   uint64_t count) {
+    if (service && label == UINT32_MAX)
+        return WEB_INVALID;
+    return create_filter(lib, handle, service, label, params, count, 3);
+}
+static PSN_GUEST_ABI int32_t web_delete_filter(int32_t lib, int32_t id) {
+    pthread_mutex_lock(&web_lock);
+    Filter *filter = find_filter(id);
+    int32_t result = 0;
+    if (!filter || filter->library != lib)
+        result = WEB_NO_FILTER;
+    else if (filter->references)
+        result = WEB_BUSY;
+    else {
+        Filter **link = &filters;
+        while (*link != filter)
+            link = &(*link)->next;
+        *link = filter->next;
+        free(filter->service);
+        free(filter);
+    }
+    pthread_mutex_unlock(&web_lock);
+    return result;
+}
+static int32_t register_callback(int32_t context, int32_t filter_id, void *callback, void *arg,
+                                 uint32_t kind) {
+    if (!callback)
+        return WEB_INVALID;
+    pthread_mutex_lock(&web_lock);
+    Context *owner = find_context(context);
+    Filter *filter = find_filter(filter_id);
+    int32_t result = 0;
+    unsigned count = 0;
+    for (Registration *r = registrations; r; r = r->next)
+        count++;
+    if (!owner)
+        result = WEB_NO_CONTEXT;
+    else if (!filter || filter->library != owner->library || filter->kind != kind)
+        result = WEB_NO_FILTER;
+    else if (count >= MAX_OBJECTS)
+        result = WEB_NOMEM;
+    Registration *registration = result ? NULL : calloc(1, sizeof(*registration));
+    if (!result && !registration)
+        result = WEB_NOMEM;
+    if (!result) {
+        registration->id = allocate_id();
+        registration->context = context;
+        registration->callback = callback;
+        registration->arg = arg;
+        registration->filter = filter;
+        void *instance;
+        const PsnBackendV1 *backend = psn_host_lock(&instance);
+        if (!backend)
+            result = PSN_BACKEND_UNAVAILABLE;
+        for (uint32_t i = 0; !result && i < filter->count; i++) {
+            const char *keys[PSN_MAX_EXT_DATA];
+            for (uint32_t k = 0; k < filter->params[i].key_count; k++)
+                keys[k] = filter->params[i].keys[k];
+            PsnPushFilter input = {.user_id = owner->user,
+                                   .kind = kind,
+                                   .service = filter->service,
+                                   .data_type = filter->params[i].type,
+                                   .ext_keys = keys,
+                                   .ext_key_count = filter->params[i].key_count,
+                                   .service_label = filter->label};
+            if (next_cookie == UINT64_MAX) {
+                result = WEB_NOMEM;
+                break;
+            }
+            uint64_t cookie = next_cookie++;
+            result = backend->subscribe(instance, cookie, &input);
+            if (!result)
+                registration->cookies[i] = cookie;
+        }
+        if (result && backend)
+            for (uint32_t i = 0; i < filter->count; i++)
+                if (registration->cookies[i])
+                    backend->unsubscribe(instance, registration->cookies[i]);
+        psn_host_unlock();
+        if (!result) {
+            filter->references++;
+            registration->next = registrations;
+            registrations = registration;
+            result = registration->id;
+            registration = NULL;
+        }
+    }
+    free(registration);
+    pthread_mutex_unlock(&web_lock);
+    return translate_error(result);
+}
+static PSN_GUEST_ABI int32_t web_register_basic(int32_t context, int32_t filter, void *callback,
+                                                void *arg) {
+    return register_callback(context, filter, callback, arg, 1);
+}
+static PSN_GUEST_ABI int32_t web_register_service(int32_t context, int32_t filter, void *callback,
+                                                  void *arg) {
+    return register_callback(context, filter, callback, arg, 2);
+}
+static PSN_GUEST_ABI int32_t web_register_extended(int32_t context, int32_t filter, void *callback,
+                                                   void *arg) {
+    return register_callback(context, filter, callback, arg, 3);
+}
+static PSN_GUEST_ABI int32_t web_unregister(int32_t context, int32_t id) {
+    pthread_mutex_lock(&web_lock);
+    Registration *found = NULL;
+    for (Registration *r = registrations; r; r = r->next)
+        if (r->context == context && r->id == id) {
+            found = r;
+            break;
+        }
+    if (found)
+        remove_registration(found);
+    pthread_mutex_unlock(&web_lock);
+    return found ? 0 : WEB_NO_CALLBACK;
+}
+
+int32_t psn_host_webapi_event(const PsnPushEvent *event) {
+    if (!event || !event->subscription || !event->data_type || strnlen(event->data_type, 65) > 64 ||
+        (event->service && strnlen(event->service, 256) > 255) ||
+        event->data.size > MAX_QUEUE_BYTES || (event->data.size && !event->data.data) ||
+        event->ext_data_count > PSN_MAX_EXT_DATA || (event->ext_data_count && !event->ext_data))
+        return WEB_INVALID;
+    Push *push = calloc(1, sizeof(*push));
+    if (!push)
+        return WEB_NOMEM;
+    push->event = *event;
+    push->event.data.data = NULL;
+    push->event.ext_data = push->ext;
+    push->event.ext_data_count = 0;
+    memcpy(push->type, event->data_type, strlen(event->data_type) + 1);
+    push->event.data_type = push->type;
+    if (event->service) {
+        memcpy(push->service, event->service, strlen(event->service) + 1);
+        push->event.service = push->service;
+    }
+    push->allocation_size = sizeof(*push) + event->data.size;
+    if (event->data.size) {
+        void *data = malloc((size_t)event->data.size);
+        if (!data) {
+            free_push(push);
+            return WEB_NOMEM;
+        }
+        memcpy(data, event->data.data, (size_t)event->data.size);
+        push->event.data.data = data;
+    }
+    for (uint32_t i = 0; i < event->ext_data_count; i++) {
+        const PsnExtData *source = &event->ext_data[i];
+        if (!source->key || strnlen(source->key, 33) > 32 || source->value.size > MAX_QUEUE_BYTES ||
+            (source->value.size && !source->value.data) ||
+            push->allocation_size + source->value.size > MAX_QUEUE_BYTES) {
+            free_push(push);
+            return WEB_INVALID;
+        }
+        memcpy(push->keys[i], source->key, strlen(source->key) + 1);
+        push->ext[i].key = push->keys[i];
+        push->ext[i].value.size = source->value.size;
+        if (source->value.size) {
+            void *data = malloc((size_t)source->value.size);
+            if (!data) {
+                free_push(push);
+                return WEB_NOMEM;
+            }
+            memcpy(data, source->value.data, (size_t)source->value.size);
+            push->ext[i].value.data = data;
+        }
+        push->event.ext_data_count++;
+        push->allocation_size += source->value.size;
+    }
+    pthread_mutex_lock(&web_lock);
+    if (queue_count >= MAX_OBJECTS || queue_bytes + push->allocation_size > MAX_QUEUE_BYTES) {
+        pthread_mutex_unlock(&web_lock);
+        free_push(push);
+        return WEB_BUSY;
+    }
+    if (push_tail)
+        push_tail->next = push;
+    else
+        push_head = push;
+    push_tail = push;
+    queue_count++;
+    queue_bytes += push->allocation_size;
+    pthread_mutex_unlock(&web_lock);
+    return 0;
+}
+static GuestOnlineId guest_online(const char *name) {
+    GuestOnlineId value = {0};
+    memcpy(value.name, name, strnlen(name, 16));
+    return value;
+}
+void psn_host_webapi_dispatch(void) {
+    pthread_mutex_lock(&web_lock);
+    if (dispatching) {
+        pthread_mutex_unlock(&web_lock);
+        return;
+    }
+    dispatching = 1;
+    /* Detach one finite batch. Reentrant pumps queue work for the next CheckCallback. */
+    Push *batch = push_head;
+    push_head = push_tail = NULL;
+    queue_count = 0;
+    queue_bytes = 0;
+    while (batch) {
+        Push *event = batch;
+        batch = batch->next;
+        Registration *found = NULL;
+        uint32_t parameter = 0;
+        for (Registration *r = registrations; !found && r; r = r->next)
+            for (uint32_t i = 0; i < r->filter->count; i++)
+                if (r->cookies[i] == event->event.subscription) {
+                    found = r;
+                    parameter = i;
+                    break;
+                }
+        void *callback = NULL, *arg = NULL;
+        Registration *pinned = NULL;
+        int32_t context = 0, id = 0;
+        uint32_t kind = 0, label = 0;
+        char service[256] = {0};
+        int has_service = 0;
+        GuestExtData ext[PSN_MAX_EXT_DATA] = {0};
+        uint64_t ext_count = 0;
+        if (found) {
+            Filter *filter = found->filter;
+            FilterParam *param = &filter->params[parameter];
+            /* A NULL service means no service, while "" is a named empty service. */
+            int same_service = filter->service && event->event.service
+                                   ? !strcmp(filter->service, event->event.service)
+                                   : !filter->service && !event->event.service;
+            if (!strcmp(param->type, event->event.data_type) && same_service &&
+                (!filter->service || filter->label == event->event.service_label)) {
+                callback = found->callback;
+                arg = found->arg;
+                context = found->context;
+                id = found->id;
+                kind = filter->kind;
+                label = filter->label;
+                pinned = found;
+                pinned->in_flight++;
+                if (filter->service) {
+                    has_service = 1;
+                    memcpy(service, filter->service, strlen(filter->service) + 1);
+                }
+                for (uint32_t i = 0; i < event->event.ext_data_count; i++)
+                    for (uint32_t k = 0; k < param->key_count; k++)
+                        if (!strcmp(event->ext[i].key, param->keys[k])) {
+                            GuestExtData *out = &ext[ext_count++];
+                            memcpy(out->key.value, event->ext[i].key,
+                                   strlen(event->ext[i].key) + 1);
+                            out->data = event->ext[i].value.data;
+                            out->size = event->ext[i].value.size;
+                            break;
+                        }
+            }
+        }
+        /* The dispatch frame owns all data and snapshots the registration, so callbacks
+         * may unregister themselves, delete contexts, or call CheckCallback recursively. */
+        pthread_mutex_unlock(&web_lock);
+        if (callback) {
+            active_callback = pinned;
+            GuestDataType type = {0};
+            memcpy(type.value, event->event.data_type, strlen(event->event.data_type) + 1);
+            GuestPeer to = {guest_online(event->event.to_online_id), event->event.to_platform};
+            GuestPeer from = {guest_online(event->event.from_online_id),
+                              event->event.from_platform};
+            if (kind == 1)
+                ((BasicCallback)callback)(context, id, &to, &from, &type, event->event.data.data,
+                                          event->event.data.size, arg);
+            else if (kind == 2)
+                ((ServiceCallback)callback)(context, id, has_service ? service : NULL, label, &to,
+                                            &from, &type, event->event.data.data,
+                                            event->event.data.size, arg);
+            else {
+                GuestPeerA to_a = {event->event.to_account_id, event->event.to_platform, {0}},
+                           from_a = {event->event.from_account_id, event->event.from_platform, {0}};
+                ((ExtendedCallback)callback)(
+                    context, id, has_service ? service : NULL, label, to_a.account ? &to_a : NULL,
+                    to.online.name[0] ? &to.online : NULL, from_a.account ? &from_a : NULL,
+                    from.online.name[0] ? &from.online : NULL, &type, event->event.data.data,
+                    event->event.data.size, ext_count ? ext : NULL, ext_count, arg);
+            }
+            active_callback = NULL;
+        }
+        free_push(event);
+        pthread_mutex_lock(&web_lock);
+        if (pinned) {
+            pinned->in_flight--;
+            pthread_cond_broadcast(&callback_idle);
+            if (pinned->retired && !pinned->waiting)
+                free(pinned);
+        }
+    }
+    dispatching = 0;
+    pthread_mutex_unlock(&web_lock);
+}
+static PSN_GUEST_ABI int32_t web_terminate(int32_t id) {
+    pthread_mutex_lock(&web_lock);
+    Library *library = find_library(id);
+    if (!library) {
+        pthread_mutex_unlock(&web_lock);
+        return WEB_NO_LIB;
+    }
+    Library **link = &libraries;
+    while (*link != library)
+        link = &(*link)->next;
+    *link = library->next;
+    for (;;) {
+        Context *context = contexts;
+        while (context && context->library != id)
+            context = context->next;
+        if (!context)
+            break;
+        remove_context(context);
+    }
+    Filter **filter = &filters;
+    while (*filter) {
+        if ((*filter)->library == id) {
+            Filter *old = *filter;
+            *filter = old->next;
+            free(old->service);
+            free(old);
+        } else
+            filter = &(*filter)->next;
+    }
+    Handle **handle = &handles;
+    while (*handle) {
+        if ((*handle)->library == id) {
+            Handle *old = *handle;
+            *handle = old->next;
+            free(old);
+        } else
+            handle = &(*handle)->next;
+    }
+    free(library);
+    pthread_mutex_unlock(&web_lock);
+    return 0;
+}
+void psn_host_webapi_reset(void) {
+    pthread_mutex_lock(&web_lock);
+    while (registrations)
+        remove_registration(registrations);
+    while (contexts)
+        remove_context(contexts);
+    while (filters) {
+        Filter *old = filters;
+        filters = old->next;
+        free(old->service);
+        free(old);
+    }
+    while (handles) {
+        Handle *old = handles;
+        handles = old->next;
+        free(old);
+    }
+    while (libraries) {
+        Library *old = libraries;
+        libraries = old->next;
+        free(old);
+    }
+    while (push_head) {
+        Push *old = push_head;
+        push_head = old->next;
+        free_push(old);
+    }
+    push_tail = NULL;
+    queue_count = 0;
+    queue_bytes = 0;
+    pthread_mutex_unlock(&web_lock);
+}
+
+uintptr_t psn_host_webapi_resolve(const char *name) {
+    static const PsnHostExport exports[] = {
+        {"sceNpWebApiInitialize", web_initialize},
+        {"sceNpWebApiTerminate", web_terminate},
+        {"sceNpWebApiCreateContext", web_create_context},
+        {"sceNpWebApiCreateContextA", web_create_context_a},
+        {"sceNpWebApiDeleteContext", web_delete_context},
+        {"sceNpWebApiCreateRequest", web_create_request},
+        {"sceNpWebApiSendRequest", web_send},
+        {"sceNpWebApiSendRequest2", web_send2},
+        {"sceNpWebApiAddHttpRequestHeader", web_add_header},
+        {"sceNpWebApiReadData", web_read},
+        {"sceNpWebApiAbortRequest", web_abort},
+        {"sceNpWebApiDeleteRequest", web_delete_request},
+        {"sceNpWebApiSetRequestTimeout", web_timeout},
+        {"sceNpWebApiGetHttpStatusCode", web_status},
+        {"sceNpWebApiGetHttpResponseHeaderValue", web_header_value},
+        {"sceNpWebApiGetHttpResponseHeaderValueLength", web_header_length},
+        {"sceNpWebApiCreateHandle", web_create_handle},
+        {"sceNpWebApiDeleteHandle", web_delete_handle},
+        {"sceNpWebApiCreatePushEventFilter", web_create_basic_filter},
+        {"sceNpWebApiCreateServicePushEventFilter", web_create_service_filter},
+        {"sceNpWebApiCreateExtdPushEventFilter", web_create_ext_filter},
+        {"sceNpWebApiDeletePushEventFilter", web_delete_filter},
+        {"sceNpWebApiDeleteServicePushEventFilter", web_delete_filter},
+        {"sceNpWebApiDeleteExtdPushEventFilter", web_delete_filter},
+        {"sceNpWebApiRegisterPushEventCallback", web_register_basic},
+        {"sceNpWebApiRegisterServicePushEventCallback", web_register_service},
+        {"sceNpWebApiRegisterExtdPushEventCallbackA", web_register_extended},
+        {"sceNpWebApiUnregisterPushEventCallback", web_unregister},
+        {"sceNpWebApiUnregisterServicePushEventCallback", web_unregister},
+        {"sceNpWebApiUnregisterExtdPushEventCallback", web_unregister},
+    };
+    return PSN_LOOKUP(exports, name);
+}
diff --git a/platform/psn/tests/psn_backend_fixture.c b/platform/psn/tests/psn_backend_fixture.c
new file mode 100644
index 0000000000000000000000000000000000000000..21d6bf6f76b3d57c7ea8298e93f7460cff23b7f7
--- /dev/null
+++ b/platform/psn/tests/psn_backend_fixture.c
@@ -0,0 +1,257 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* A deterministic shared module for host-boundary tests. No platform SDK or network. */
+#include "../include/psn_backend.h"
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#define EXPORT __declspec(dllexport)
+#else
+#define EXPORT __attribute__((visibility("default")))
+#endif
+
+typedef struct FixtureStats {
+    unsigned opens, closes, event_calls, identity_calls, configuration_matches;
+} FixtureStats;
+
+static FixtureStats stats;
+static unsigned event_index;
+static char service[32], data_type[65], key[33];
+static unsigned char body[5], extra[3];
+static PsnExtData ext;
+
+static int is_case(const char *name) {
+    const char *mode = getenv("PSN_TEST_CASE");
+    return mode && strcmp(mode, name) == 0;
+}
+
+EXPORT const FixtureStats *psn_fixture_stats(void) { return &stats; }
+
+static void poison_borrowed_output(void) {
+    memset(service, 'x', sizeof(service) - 1);
+    service[sizeof(service) - 1] = 0;
+    strcpy(data_type, "overwritten");
+    strcpy(key, "overwritten");
+    memset(body, 0xdd, sizeof(body));
+    memset(extra, 0xee, sizeof(extra));
+    ext.key = "overwritten";
+    ext.value = (PsnBytes){NULL, 0};
+}
+
+static int32_t fixture_open(const char *configuration, void **instance) {
+    ++stats.opens;
+    stats.configuration_matches = strcmp(configuration, "fixture configuration: = preserved") == 0;
+    if (!stats.configuration_matches)
+        return PSN_INVALID_ARGUMENT;
+    if (is_case("open-null")) {
+        *instance = NULL;
+        return 0;
+    }
+    if (is_case("open-error")) {
+        *instance = NULL;
+        return PSN_BACKEND_BUSY;
+    }
+    *instance = &stats;
+    return is_case("open-partial") ? PSN_BACKEND_ABORTED : 0;
+}
+
+static void fixture_close(void *instance) {
+    if (instance == &stats)
+        ++stats.closes;
+}
+
+static int32_t fixture_identity(void *instance, int32_t user_id, PsnIdentity *out) {
+    if (instance != &stats || !out || user_id != 1)
+        return PSN_INVALID_ARGUMENT;
+    ++stats.identity_calls;
+    poison_borrowed_output();
+    *out = (PsnIdentity){.account_id = UINT64_C(0xfedcba9876543210), .state = 2};
+    strcpy(out->online_id, "FixtureUser");
+    return 0;
+}
+static int32_t fixture_policy(void *ctx, int32_t user_id, uint64_t features, PsnPolicy *out) {
+    (void)ctx;
+    (void)user_id;
+    (void)features;
+    memset(out, 0, sizeof(*out));
+    return 0;
+}
+static int32_t fixture_title(void *ctx, const char *id, PsnBytes secret) {
+    (void)ctx;
+    (void)id;
+    (void)secret;
+    return 0;
+}
+static int32_t fixture_restriction(void *ctx, const PsnContentRestriction *restriction) {
+    (void)ctx;
+    (void)restriction;
+    return 0;
+}
+static int32_t fixture_auth_start(void *ctx, const PsnAuthRequest *request, uint64_t *id) {
+    (void)ctx;
+    (void)request;
+    (void)id;
+    return PSN_BACKEND_UNSUPPORTED;
+}
+static int32_t fixture_auth_poll(void *ctx, uint64_t id, PsnAuthResult *out) {
+    (void)ctx;
+    (void)id;
+    (void)out;
+    return PSN_BACKEND_UNSUPPORTED;
+}
+static int32_t fixture_web_start(void *ctx, const PsnWebRequest *request, uint64_t *id) {
+    (void)ctx;
+    (void)request;
+    (void)id;
+    return PSN_BACKEND_UNSUPPORTED;
+}
+static int32_t fixture_web_poll(void *ctx, uint64_t id, PsnWebResponse *out) {
+    (void)ctx;
+    (void)id;
+    (void)out;
+    return PSN_BACKEND_UNSUPPORTED;
+}
+static int32_t fixture_subscribe(void *ctx, uint64_t cookie, const PsnPushFilter *filter) {
+    (void)ctx;
+    (void)cookie;
+    (void)filter;
+    return 0;
+}
+static void fixture_release(void *ctx, uint64_t id) {
+    (void)ctx;
+    (void)id;
+}
+static int32_t fixture_invitation_start(void *ctx, const PsnInvitationRequest *request,
+                                        uint64_t *id) {
+    (void)ctx;
+    (void)request;
+    (void)id;
+    return PSN_BACKEND_UNSUPPORTED;
+}
+static int32_t fixture_invitation_poll(void *ctx, uint64_t id, PsnInvitationResult *out) {
+    (void)ctx;
+    (void)id;
+    (void)out;
+    return PSN_BACKEND_UNSUPPORTED;
+}
+
+static void make_invitation(PsnEvent *event, unsigned index) {
+    memset(event, 0, sizeof(*event));
+    event->kind = 3;
+    event->user_id = 3;
+    PsnSessionInvitation *invite = &event->data.invitation;
+    memset(invite->session_id, 'S', 45);
+    invite->session_id[0] = (char)('A' + index % 26);
+    memset(invite->invitation_id, 'I', 60);
+    invite->flag = 0xa1b2c3d4u;
+    invite->accepting_user_id = 3;
+    memset(invite->accepting_online_id, 'A', 16);
+    memset(invite->referring_online_id, 'R', 16);
+    invite->referring_account_id = UINT64_C(0xfedcba9876543210);
+}
+
+static int32_t fixture_event_next(void *ctx, PsnEvent *event) {
+    if (ctx != &stats || !event)
+        return PSN_INVALID_ARGUMENT;
+    ++stats.event_calls;
+    poison_borrowed_output();
+    memset(event, 0, sizeof(*event));
+    if (is_case("event-error"))
+        return PSN_BACKEND_ABORTED;
+    if (is_case("invalid-event")) {
+        event->kind = 99;
+        return 1;
+    }
+    if (is_case("overflow")) {
+        make_invitation(event, event_index++);
+        return 1;
+    }
+    if (event_index == 0) {
+        make_invitation(event, event_index++);
+        if (is_case("invalid-invite"))
+            memset(event->data.invitation.session_id, 'X', 46);
+        if (is_case("invalid-user"))
+            event->data.invitation.accepting_user_id = 5;
+        return 1;
+    }
+    if (event_index == 1) {
+        ++event_index;
+        event->kind = 1;
+        event->user_id = 1;
+        event->data.identity =
+            (PsnIdentity){.account_id = UINT64_C(0x123456789abcdef0), .state = 2};
+        strcpy(event->data.identity.online_id, "ChangedUser");
+        if (is_case("invalid-state"))
+            event->data.identity.state = 3;
+        return 1;
+    }
+    if (event_index == 2) {
+        ++event_index;
+        event->kind = 2;
+        event->user_id = 1;
+        service[0] = 0; /* Empty service is a meaningful part of a service push filter. */
+        strcpy(data_type, "np:service:presence:onlineStatus");
+        strcpy(key, "additionalTrigger");
+        memcpy(body, "b\0in\xff", 5);
+        memcpy(extra, "e\0x", 3);
+        ext = (PsnExtData){key, {extra, sizeof(extra)}};
+        PsnPushEvent *push = &event->data.push;
+        push->subscription = UINT64_C(0xf000000000000007);
+        push->from_account_id = UINT64_C(0x123456789abcdef0);
+        push->to_account_id = UINT64_C(0xfedcba9876543210);
+        strcpy(push->from_online_id, "Sender");
+        strcpy(push->to_online_id, "Receiver");
+        push->from_platform = push->to_platform = 3;
+        push->service = service;
+        push->data_type = data_type;
+        push->data = (PsnBytes){body, sizeof(body)};
+        push->ext_data = &ext;
+        push->ext_data_count = 1;
+        push->service_label = 4;
+        if (is_case("invalid-push"))
+            push->data.data = NULL;
+        if (is_case("oversized-push"))
+            push->data.size = PSN_MAX_BODY + UINT64_C(1);
+        return 1;
+    }
+    return 0;
+}
+
+EXPORT const PsnBackendV1 *psn_backend_query(uint32_t version) {
+    static PsnBackendV1 table;
+    if (version != PSN_BACKEND_ABI_V1 || is_case("query-null"))
+        return NULL;
+    table = (PsnBackendV1){.size = sizeof(table),
+                           .abi_version = PSN_BACKEND_ABI_V1,
+                           .capabilities = PSN_PROFILE_SOCIAL_V1,
+                           .open = fixture_open,
+                           .close = fixture_close,
+                           .identity = fixture_identity,
+                           .policy = fixture_policy,
+                           .set_title = fixture_title,
+                           .set_content_restriction = fixture_restriction,
+                           .auth_start = fixture_auth_start,
+                           .auth_poll = fixture_auth_poll,
+                           .auth_cancel = fixture_release,
+                           .auth_release = fixture_release,
+                           .web_start = fixture_web_start,
+                           .web_poll = fixture_web_poll,
+                           .web_cancel = fixture_release,
+                           .web_release = fixture_release,
+                           .subscribe = fixture_subscribe,
+                           .unsubscribe = fixture_release,
+                           .event_next = fixture_event_next,
+                           .invitation_start = fixture_invitation_start,
+                           .invitation_poll = fixture_invitation_poll,
+                           .invitation_cancel = fixture_release,
+                           .invitation_release = fixture_release};
+    if (is_case("bad-abi"))
+        ++table.abi_version;
+    if (is_case("bad-size"))
+        --table.size;
+    if (is_case("bad-capabilities"))
+        table.capabilities &= ~PSN_CAP_PUSH;
+    if (is_case("missing-function"))
+        table.invitation_poll = NULL;
+    return &table;
+}
diff --git a/platform/psn/tests/test_psn_backend.c b/platform/psn/tests/test_psn_backend.c
new file mode 100644
index 0000000000000000000000000000000000000000..5dc5ab1143afd2223c3cfe40dd128383b40ff496
--- /dev/null
+++ b/platform/psn/tests/test_psn_backend.c
@@ -0,0 +1,261 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Dynamic module and event ownership tests. Each case runs in a fresh process because
+ * backend selection is immutable. No game, renderer, platform SDK, or network is used.
+ * Usage: test-psn-backend <absolute fixture library path> <case> */
+#define _POSIX_C_SOURCE 200809L
+#include "psn_host.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+static int failures;
+static unsigned states, pushes, identity_resets, webapi_resets;
+static const char *test_case;
+#define CHECK(cond)                                                                                \
+    do {                                                                                           \
+        if (!(cond)) {                                                                             \
+            fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #cond);                             \
+            ++failures;                                                                            \
+        }                                                                                          \
+    } while (0)
+
+typedef struct FixtureStats {
+    unsigned opens, closes, event_calls, identity_calls, configuration_matches;
+} FixtureStats;
+typedef const FixtureStats *(*FixtureStatsFn)(void);
+
+static void set_environment(const char *key, const char *value) {
+#ifdef _WIN32
+    CHECK(_putenv_s(key, value ? value : "") == 0);
+#else
+    CHECK((value ? setenv(key, value, 1) : unsetenv(key)) == 0);
+#endif
+}
+
+static void overwrite_backend_buffers(void) {
+    void *instance;
+    const PsnBackendV1 *backend = psn_host_lock(&instance);
+    CHECK(backend != NULL && instance != NULL);
+    if (backend) {
+        PsnIdentity identity;
+        CHECK(backend->identity(instance, 1, &identity) == 0);
+        CHECK(identity.account_id == UINT64_C(0xfedcba9876543210));
+    }
+    psn_host_unlock();
+}
+
+/* Stub the two guest adapters, not the loader. Reenter the backend during delivery to
+ * invalidate its borrowed output and prove the core unlocked and copied before dispatch. */
+int32_t psn_host_identity_event(const PsnEvent *event) {
+    ++states;
+    overwrite_backend_buffers();
+    CHECK(event->kind == 1 && event->user_id == 1);
+    CHECK(event->data.identity.state == 2);
+    CHECK(event->data.identity.account_id == UINT64_C(0x123456789abcdef0));
+    CHECK(strcmp(event->data.identity.online_id, "ChangedUser") == 0);
+    return strcmp(test_case, "state-error") == 0 ? PSN_BACKEND_BUSY : 0;
+}
+int32_t psn_host_webapi_event(const PsnPushEvent *event) {
+    ++pushes;
+    overwrite_backend_buffers();
+    CHECK(event->subscription == UINT64_C(0xf000000000000007));
+    CHECK(event->from_account_id == UINT64_C(0x123456789abcdef0));
+    CHECK(event->to_account_id == UINT64_C(0xfedcba9876543210));
+    CHECK(strcmp(event->from_online_id, "Sender") == 0 &&
+          strcmp(event->to_online_id, "Receiver") == 0);
+    CHECK(event->from_platform == 3 && event->to_platform == 3 && event->service_label == 4);
+    CHECK(strcmp(event->service, "") == 0);
+    CHECK(strcmp(event->data_type, "np:service:presence:onlineStatus") == 0);
+    CHECK(event->data.size == 5 && memcmp(event->data.data, "b\0in\xff", 5) == 0);
+    CHECK(event->ext_data_count == 1);
+    if (event->ext_data_count == 1) {
+        CHECK(strcmp(event->ext_data[0].key, "additionalTrigger") == 0);
+        CHECK(event->ext_data[0].value.size == 3 &&
+              memcmp(event->ext_data[0].value.data, "e\0x", 3) == 0);
+    }
+    return strcmp(test_case, "push-error") == 0 ? PSN_BACKEND_BUSY : 0;
+}
+void psn_host_identity_dispatch(void) {}
+void psn_host_webapi_dispatch(void) {}
+void psn_host_identity_reset(void) { ++identity_resets; }
+void psn_host_webapi_reset(void) { ++webapi_resets; }
+static PSN_GUEST_ABI int32_t known_identity(void) { return 11; }
+static PSN_GUEST_ABI int32_t known_webapi(void) { return 22; }
+uintptr_t psn_host_identity_resolve(const char *name) {
+    return strcmp(name, "sceNpKnownIdentity") == 0 ? (uintptr_t)known_identity : 0;
+}
+uintptr_t psn_host_webapi_resolve(const char *name) {
+    return strcmp(name, "sceNpKnownWebApi") == 0 ? (uintptr_t)known_webapi : 0;
+}
+static void *retain_fixture(const char *path, FixtureStatsFn *stats) {
+#ifdef _WIN32
+    wchar_t wide[32768];
+    CHECK(MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, wide, 32768) != 0);
+    HMODULE library = LoadLibraryExW(
+        wide, NULL, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    FARPROC fn = library ? GetProcAddress(library, "psn_fixture_stats") : NULL;
+    memcpy(stats, &fn, sizeof(*stats));
+#else
+    void *library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    void *fn = library ? dlsym(library, "psn_fixture_stats") : NULL;
+    memcpy(stats, &fn, sizeof(*stats));
+#endif
+    CHECK(library != NULL && *stats != NULL);
+    return library;
+}
+static void release_fixture(void *library) {
+    if (!library)
+        return;
+#ifdef _WIN32
+    FreeLibrary((HMODULE)library);
+#else
+    dlclose(library);
+#endif
+}
+
+static void check_invitation_queue(void) {
+    unsigned char actual[184], expected[180] = {0};
+    const int32_t kind = 0x10000002, user = 3;
+    const uint32_t flag = 0xa1b2c3d4u;
+    const uint64_t account = UINT64_C(0xfedcba9876543210);
+    CHECK(psn_host_system_count() == 1);
+    CHECK(states == 1 && pushes == 1);
+    /* Polling status does not expire/reoffer an accepted invitation or manufacture one
+     * from friend/state pushes. Only receive consumes it. */
+    for (unsigned i = 0; i < 20; ++i)
+        CHECK(psn_host_system_count() == 1);
+    CHECK(psn_host_system_receive(NULL) == (int32_t)0x80a10003);
+    CHECK(psn_host_system_count() == 1);
+    memset(actual, 0xcc, sizeof(actual));
+    CHECK(psn_host_system_receive(actual) == 0);
+    memcpy(expected, &kind, 4);
+    memset(expected + 4, 'S', 45);
+    expected[4] = 'A';
+    memset(expected + 4 + 48, 'I', 60);
+    memcpy(expected + 4 + 112, &flag, 4);
+    memset(expected + 4 + 120, 'A', 16);
+    memcpy(expected + 4 + 140, &user, 4);
+    memset(expected + 4 + 144, 'R', 16);
+    memcpy(expected + 4 + 168, &account, 8);
+    CHECK(memcmp(actual, expected, sizeof(expected)) == 0);
+    for (unsigned i = sizeof(expected); i < sizeof(actual); ++i)
+        CHECK(actual[i] == 0xcc);
+    CHECK(psn_host_system_count() == 0);
+    memset(actual, 0xcc, sizeof(actual));
+    for (unsigned i = 0; i < 20; ++i)
+        CHECK(psn_host_system_receive(actual) == (int32_t)0x80a10004);
+    for (unsigned i = 0; i < sizeof(actual); ++i)
+        CHECK(actual[i] == 0xcc);
+    CHECK(states == 1 && pushes == 1);
+}
+
+static void check_resolver(void) {
+    CHECK(psn_host_resolve("sceNpKnownIdentity") == (uintptr_t)known_identity);
+    CHECK(psn_host_resolve("sceNpKnownWebApi") == (uintptr_t)known_webapi);
+    CHECK(psn_host_resolve("sceUnrelated") == 0);
+    CHECK(psn_host_resolve("sceNpTrophyUnlockTrophy") == 0);
+    typedef int32_t(PSN_GUEST_ABI * GuestFn)(void);
+    GuestFn unsupported = (GuestFn)psn_host_resolve("sceNpUnsupported");
+    CHECK(unsupported != NULL);
+    if (unsupported)
+        CHECK(unsupported() == PSN_BACKEND_UNSUPPORTED);
+    CHECK(psn_host_resolve("sceInvitationDialogUnsupported") != 0);
+}
+
+int main(int argc, char **argv) {
+    if (argc != 3) {
+        fprintf(stderr, "usage: %s <absolute fixture library> <case>\n", argv[0]);
+        return 2;
+    }
+    const char *path = argv[1];
+    test_case = argv[2];
+    set_environment("PSN_TEST_CASE", test_case);
+    set_environment("BB_PSN_BACKEND_CONFIG", "fixture configuration: = preserved");
+    if (strcmp(test_case, "default") == 0 || strcmp(test_case, "empty") == 0) {
+        set_environment("BB_PSN_BACKEND", strcmp(test_case, "empty") == 0 ? "" : NULL);
+        CHECK(psn_host_selected() == 0 && psn_host_start() == 0);
+        CHECK(psn_host_resolve("sceNpKnownIdentity") == 0);
+        CHECK(psn_host_pump() == 0);
+        set_environment("BB_PSN_BACKEND", path);
+        CHECK(psn_host_selected() == 0 && psn_host_start() == 0);
+        psn_host_stop();
+        psn_host_stop();
+        return failures ? 1 : 0;
+    }
+    if (strcmp(test_case, "relative") == 0)
+        path = "psn_backend_fixture.dll";
+    char missing[32768];
+    if (strcmp(test_case, "missing") == 0) {
+        snprintf(missing, sizeof(missing), "%s.missing", path);
+        path = missing;
+    }
+    set_environment("BB_PSN_BACKEND", path);
+    CHECK(psn_host_selected() == 1);
+    const int init_failure =
+        strcmp(test_case, "relative") == 0 || strcmp(test_case, "missing") == 0 ||
+        strncmp(test_case, "bad-", 4) == 0 || strcmp(test_case, "missing-function") == 0 ||
+        strcmp(test_case, "query-null") == 0 || strncmp(test_case, "open-", 5) == 0;
+    int32_t result = psn_host_start();
+    if (init_failure) {
+        int32_t expected = strcmp(test_case, "open-error") == 0     ? PSN_BACKEND_BUSY
+                           : strcmp(test_case, "open-partial") == 0 ? PSN_BACKEND_ABORTED
+                                                                    : PSN_BACKEND_UNAVAILABLE;
+        CHECK(result == expected);
+        set_environment("BB_PSN_BACKEND", NULL);
+        CHECK(psn_host_selected() == 1 && psn_host_start() == expected);
+        void *instance = (void *)1;
+        CHECK(psn_host_lock(&instance) == NULL && instance == NULL);
+        psn_host_unlock();
+        CHECK(psn_host_pump() == expected);
+        psn_host_stop();
+        psn_host_stop();
+        return failures ? 1 : 0;
+    }
+    CHECK(result == 0);
+    if (result)
+        return 1;
+    FixtureStatsFn fixture_stats = NULL;
+    void *library = retain_fixture(path, &fixture_stats);
+    if (!fixture_stats) {
+        psn_host_stop();
+        release_fixture(library);
+        return 1;
+    }
+    CHECK(fixture_stats()->opens == 1 && fixture_stats()->configuration_matches == 1);
+    CHECK(psn_host_start() == 0 && fixture_stats()->opens == 1);
+    check_resolver();
+    if (strcmp(test_case, "good") == 0) {
+        check_invitation_queue();
+        CHECK(fixture_stats()->identity_calls == 2);
+    } else {
+        int32_t expected = strcmp(test_case, "overflow") == 0 ||
+                                   strcmp(test_case, "state-error") == 0 ||
+                                   strcmp(test_case, "push-error") == 0
+                               ? PSN_BACKEND_BUSY
+                           : strcmp(test_case, "invalid-event") == 0 ? PSN_BACKEND_UNSUPPORTED
+                           : strcmp(test_case, "event-error") == 0   ? PSN_BACKEND_ABORTED
+                                                                     : PSN_INVALID_ARGUMENT;
+        CHECK(psn_host_pump() == expected);
+        const unsigned calls = fixture_stats()->event_calls;
+        if (strcmp(test_case, "overflow") == 0)
+            CHECK(calls == 33);
+        CHECK(psn_host_pump() == expected);
+        CHECK(psn_host_system_count() == expected);
+        unsigned char event[180];
+        CHECK(psn_host_system_receive(event) == expected);
+        CHECK(fixture_stats()->event_calls == calls); /* sticky failure, no replay/fallback */
+    }
+    psn_host_stop();
+    CHECK(fixture_stats()->closes == 1);
+    CHECK(identity_resets == 1 && webapi_resets == 1);
+    psn_host_stop();
+    CHECK(fixture_stats()->closes == 1);
+    release_fixture(library);
+    printf("PSN backend %s: %s\n", test_case, failures ? "FAILED" : "passed");
+    return failures ? 1 : 0;
+}
diff --git a/platform/psn/tests/test_psn_identity.c b/platform/psn/tests/test_psn_identity.c
new file mode 100644
index 0000000000000000000000000000000000000000..b3a1247063b5a462489deb858a0733b0afbece32
--- /dev/null
+++ b/platform/psn/tests/test_psn_identity.c
@@ -0,0 +1,719 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Host-only contract checks. No game, platform client or network connection. */
+#include "psn_host.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static pthread_mutex_t backend_mutex = PTHREAD_MUTEX_INITIALIZER;
+static int backend_locked, auth_pending, auth_canceled, auth_released, dialog_pending;
+static int dialog_canceled, dialog_released, web_dispatches, auth_failure;
+static int auth_started;
+static uint32_t auth_variant, auth_kind;
+static int32_t policy_failure;
+static int32_t identity_state = 2;
+static uint64_t checked_features;
+static const char *guest_client;
+static PsnInvitationResult invitation_result;
+static PsnAuthTimeout seen_timeout;
+static char seen_title[13];
+
+static int32_t identity(void *ctx, int32_t user, PsnIdentity *out) {
+    (void)ctx;
+    assert(backend_locked);
+    if (user != 1)
+        return (int32_t)0x80550007;
+    *out = (PsnIdentity){0};
+    out->account_id = 0x123456789;
+    memcpy(out->online_id, "abcdefghijklmnop", 17);
+    out->state = identity_state;
+    return 0;
+}
+static int32_t policy(void *ctx, int32_t user, uint64_t features, PsnPolicy *out) {
+    (void)ctx;
+    assert(backend_locked);
+    assert(user == 1);
+    checked_features = features;
+    if (policy_failure)
+        return policy_failure;
+    *out = (PsnPolicy){0};
+    out->age = 13;
+    out->plus_authorized = 0;
+    out->chat_restricted = 1;
+    return 0;
+}
+static int32_t title(void *ctx, const char *value, PsnBytes secret) {
+    (void)ctx;
+    assert(backend_locked);
+    assert(secret.size == 128);
+    assert(((const unsigned char *)secret.data)[127] == 23);
+    strcpy(seen_title, value);
+    return 0;
+}
+static int32_t restriction(void *ctx, const PsnContentRestriction *r) {
+    (void)ctx;
+    assert(backend_locked);
+    assert(r->default_age == 7);
+    assert(r->count == 1 && r->countries[0].age == 12 && !strcmp(r->countries[0].country, "IT"));
+    return 0;
+}
+static int32_t auth_start(void *ctx, const PsnAuthRequest *input, uint64_t *handle) {
+    (void)ctx;
+    assert(backend_locked);
+    assert(input->user_id == 1);
+    assert(input->client_id != guest_client);
+    assert(!strcmp(input->client_id, "client"));
+    assert(!strcmp(input->scope, "openid"));
