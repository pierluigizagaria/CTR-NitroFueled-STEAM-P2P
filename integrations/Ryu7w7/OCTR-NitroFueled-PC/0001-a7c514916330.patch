+    assert(POLL("sceNpAuthPollAsync", request, &result) == 0 && result == (int32_t)0x80550301);
+    assert(!strcmp((char *)first, "provider-token") && auth_started == started_before + 1);
+    for (size_t i = 0; i < sizeof(second); ++i)
