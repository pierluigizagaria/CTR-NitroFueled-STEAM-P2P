+    assert(POLL("sceNpAuthPollAsync", request, &result) == 0 && result == (int32_t)0x80550304);
+    assert(CALLID("sceNpAuthDeleteRequest", request) == 0 && auth_released == released_before + 3);
+    for (size_t i = 0; i < sizeof(first); ++i)
